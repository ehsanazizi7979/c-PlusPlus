[{"page": 24, "x": 144.0, "y": 179.1, "text": "name our first Win32 console application project TestProject. Under Location,"}, {"page": 24, "x": 126.0, "y": 295.8, "text": "3.\t In Solution Explorer, you'll see the stdafx.h and targetver.h header files. The"}, {"page": 24, "x": 144.0, "y": 307.8, "text": "stdafx.cpp and Test Project.cpp source files are also created. The stdafx.h"}, {"page": 24, "x": 144.0, "y": 319.8, "text": "and stdafx.cpp files are a part of the precompiled header which is used for an"}, {"page": 24, "x": 144.0, "y": 415.8, "text": "at the MSDN reference (http://msdn.microsoft.com)."}, {"page": 24, "x": 126.0, "y": 432.1, "text": "4.\t The Test Project.cpp file appears in the central window, and this is where you'll"}, {"page": 26, "x": 126.0, "y": 337.1, "text": "1.\t Create a new C++ console application named TestDemo."}, {"page": 26, "x": 126.0, "y": 353.4, "text": "2.\t Open TestDemo.cpp."}, {"page": 26, "x": 144.0, "y": 386.6, "text": "#include \"stdafx.h\""}, {"page": 26, "x": 144.0, "y": 397.4, "text": "#include <iostream>"}, {"page": 26, "x": 144.0, "y": 419.0, "text": "using namespace std;"}, {"page": 26, "x": 144.0, "y": 440.6, "text": "int _tmain(int argc, _TCHAR* argv[])"}, {"page": 26, "x": 144.0, "y": 451.4, "text": "{"}, {"page": 26, "x": 144.0, "y": 462.2, "text": "   cout << \"Hello world\" << endl;"}, {"page": 26, "x": 144.0, "y": 473.0, "text": "   return 0;"}, {"page": 26, "x": 144.0, "y": 483.8, "text": "}"}, {"page": 27, "x": 144.0, "y": 241.5, "text": "int _tmain(int argc, TCHAR* argv[])"}, {"page": 27, "x": 144.0, "y": 257.8, "text": "void _tmain(int argc, TCHAR* argv[])"}, {"page": 27, "x": 144.0, "y": 274.1, "text": "int _tmain(void)"}, {"page": 27, "x": 144.0, "y": 289.9, "text": "void _tmain(void)"}, {"page": 28, "x": 126.0, "y": 551.2, "text": "void CalculateSomething(int iCount)"}, {"page": 28, "x": 126.0, "y": 563.3, "text": "{"}, {"page": 28, "x": 126.0, "y": 575.4, "text": "    int iCounter = 0;"}, {"page": 28, "x": 126.0, "y": 587.5, "text": "    while (iCounter++ < iCount)"}, {"page": 28, "x": 126.0, "y": 599.6, "text": "    {"}, {"page": 28, "x": 126.0, "y": 611.6, "text": "       //make calculation"}, {"page": 28, "x": 126.0, "y": 623.7, "text": "       //update progress bar"}, {"page": 28, "x": 126.0, "y": 635.8, "text": "    }"}, {"page": 28, "x": 126.0, "y": 647.9, "text": "}"}, {"page": 30, "x": 126.0, "y": 164.1, "text": "1.\t Create a new default console application. Name it ComplexTest."}, {"page": 30, "x": 126.0, "y": 180.4, "text": "2.\t Open the ComplexTest.cpp file and insert the following code:"}, {"page": 30, "x": 144.0, "y": 197.4, "text": "#include \"stdafx.h\""}, {"page": 30, "x": 144.0, "y": 209.6, "text": "#include <iostream>"}, {"page": 30, "x": 144.0, "y": 234.1, "text": "using namespace std;"}, {"page": 30, "x": 144.0, "y": 258.6, "text": "void ComplexAdd( double dReal1, double dImg1, double dReal2,"}, {"page": 30, "x": 144.0, "y": 269.4, "text": "double dImg2, double& dReal, double& dImg )"}, {"page": 30, "x": 144.0, "y": 281.6, "text": "{"}, {"page": 30, "x": 144.0, "y": 293.8, "text": "  dReal = dReal1 + dReal2;"}, {"page": 30, "x": 144.0, "y": 306.1, "text": "  dImg = dImg1 + dImg2;"}, {"page": 30, "x": 144.0, "y": 318.3, "text": "}"}, {"page": 30, "x": 144.0, "y": 342.8, "text": "double Rand(double dMin, double dMax)"}, {"page": 30, "x": 144.0, "y": 355.0, "text": "{"}, {"page": 30, "x": 144.0, "y": 367.3, "text": "  double dVal = (double)rand() / RAND_MAX;"}, {"page": 30, "x": 144.0, "y": 379.5, "text": "  return dMin + dVal * (dMax - dMin);"}, {"page": 30, "x": 144.0, "y": 391.8, "text": "}"}, {"page": 30, "x": 144.0, "y": 416.2, "text": "int _tmain(int argc, TCHAR* argv[])"}, {"page": 30, "x": 144.0, "y": 428.5, "text": "{"}, {"page": 30, "x": 144.0, "y": 440.7, "text": "    double dReal1 = Rand( -10, 10 );"}, {"page": 30, "x": 144.0, "y": 453.0, "text": "    double dImg1 = Rand( -10, 10 );"}, {"page": 30, "x": 144.0, "y": 465.2, "text": "    double dReal2 = Rand( -10, 10 );"}, {"page": 30, "x": 144.0, "y": 477.4, "text": "    double dImg2 = Rand( -10, 10 );"}, {"page": 30, "x": 144.0, "y": 489.7, "text": "    double dReal = 0;"}, {"page": 30, "x": 144.0, "y": 501.9, "text": "    double dImg = 0;"}, {"page": 30, "x": 144.0, "y": 514.2, "text": "    ComplexAdd(dReal1, dImg1, dReal2, dImg2, dReal, dImg);"}, {"page": 30, "x": 144.0, "y": 526.4, "text": "    cout << dReal<< \"+\" <<dImg << \"i\" << endl;"}, {"page": 30, "x": 144.0, "y": 538.6, "text": "    return 0;"}, {"page": 30, "x": 144.0, "y": 550.9, "text": "}"}, {"page": 31, "x": 126.0, "y": 292.7, "text": "#include \"stdafx.h\""}, {"page": 31, "x": 126.0, "y": 304.9, "text": "#include <iostream>"}, {"page": 31, "x": 126.0, "y": 327.0, "text": "using namespace std;"}, {"page": 31, "x": 126.0, "y": 351.5, "text": "struct SComplex"}, {"page": 31, "x": 126.0, "y": 363.7, "text": "{"}, {"page": 31, "x": 126.0, "y": 375.9, "text": "    double dReal;"}, {"page": 31, "x": 126.0, "y": 388.2, "text": "    double dImg;"}, {"page": 31, "x": 126.0, "y": 400.4, "text": "};"}, {"page": 31, "x": 126.0, "y": 424.9, "text": "SComplex ComplexAdd(SComplex c1, SComplex c2)"}, {"page": 31, "x": 126.0, "y": 437.1, "text": "{"}, {"page": 31, "x": 126.0, "y": 449.4, "text": "    SComplex c;"}, {"page": 31, "x": 126.0, "y": 461.6, "text": "    c.dReal = c1.dReal + c2.dReal;"}, {"page": 31, "x": 126.0, "y": 473.9, "text": "    c.dImg = c1.dImg + c2.dImg;"}, {"page": 31, "x": 126.0, "y": 486.1, "text": "    return c;"}, {"page": 31, "x": 126.0, "y": 498.3, "text": "}"}, {"page": 31, "x": 126.0, "y": 522.8, "text": "double Rand(double dMin, double dMax)"}, {"page": 31, "x": 126.0, "y": 535.1, "text": "{"}, {"page": 31, "x": 126.0, "y": 547.3, "text": "    double dVal = (double)rand() / RAND_MAX;"}, {"page": 31, "x": 126.0, "y": 559.5, "text": "    return dMin + dVal * (dMax - dMin);"}, {"page": 31, "x": 126.0, "y": 571.8, "text": "}"}, {"page": 31, "x": 126.0, "y": 584.0, "text": "int _tmain(int argc, TCHAR* argv[])"}, {"page": 31, "x": 126.0, "y": 596.3, "text": "{"}, {"page": 31, "x": 126.0, "y": 608.5, "text": "    SComplex c1;"}, {"page": 31, "x": 126.0, "y": 620.7, "text": "    c1.dReal = Rand( -10, 10 );"}, {"page": 31, "x": 126.0, "y": 633.0, "text": "    c1.dImg = Rand( -10, 10 );"}, {"page": 32, "x": 126.0, "y": 115.3, "text": "    SComplex c2;"}, {"page": 32, "x": 126.0, "y": 127.5, "text": "    c2.dReal = Rand( -10, 10 );"}, {"page": 32, "x": 126.0, "y": 139.8, "text": "    c2.dImg = Rand( -10, 10 );"}, {"page": 32, "x": 126.0, "y": 164.3, "text": "    SComplex c = ComplexAdd( c1, c2 );"}, {"page": 32, "x": 126.0, "y": 188.7, "text": "    cout<<c.dReal<< \"+\" <<c.dImg << \"i\" << endl;"}, {"page": 32, "x": 126.0, "y": 201.0, "text": "    return 0;"}, {"page": 32, "x": 126.0, "y": 213.2, "text": "}"}, {"page": 32, "x": 126.0, "y": 539.5, "text": "1.\t Create a new console application. Name it ComplexTestOO."}, {"page": 32, "x": 126.0, "y": 555.8, "text": "2.\t Open the ComplexTestOO.cpp file and insert the following code:"}, {"page": 32, "x": 144.0, "y": 572.7, "text": "#include \"stdafx.h\""}, {"page": 32, "x": 144.0, "y": 585.0, "text": "#include <iostream>"}, {"page": 32, "x": 144.0, "y": 609.4, "text": "using namespace std;"}, {"page": 32, "x": 144.0, "y": 633.9, "text": "double Rand(double dMin, double dMax)"}, {"page": 32, "x": 144.0, "y": 646.2, "text": "{"}, {"page": 33, "x": 144.0, "y": 115.3, "text": "   double dVal = (double)rand() / RAND_MAX;"}, {"page": 33, "x": 144.0, "y": 127.5, "text": "   return dMin + dVal * (dMax - dMin);"}, {"page": 33, "x": 144.0, "y": 139.8, "text": "}"}, {"page": 33, "x": 144.0, "y": 164.3, "text": "class CComplex"}, {"page": 33, "x": 144.0, "y": 176.5, "text": "{"}, {"page": 33, "x": 144.0, "y": 188.7, "text": "public:"}, {"page": 33, "x": 144.0, "y": 201.0, "text": "   CComplex( )"}, {"page": 33, "x": 144.0, "y": 213.2, "text": "   {"}, {"page": 33, "x": 144.0, "y": 225.5, "text": "      dReal = Rand( -10, 10 );"}, {"page": 33, "x": 144.0, "y": 237.7, "text": "      dImg = Rand( -10, 10 );"}, {"page": 33, "x": 144.0, "y": 249.9, "text": "   }"}, {"page": 33, "x": 144.0, "y": 262.2, "text": "   CComplex(double dReal, double dImg)"}, {"page": 33, "x": 144.0, "y": 274.4, "text": "   {"}, {"page": 33, "x": 144.0, "y": 286.6, "text": "      this->dReal = dReal;"}, {"page": 33, "x": 144.0, "y": 298.9, "text": "      this->dImg = dImg;"}, {"page": 33, "x": 144.0, "y": 311.1, "text": "   }"}, {"page": 33, "x": 144.0, "y": 323.4, "text": "   friend CComplex operator+ (const CComplex& c1, const CComplex&"}, {"page": 33, "x": 144.0, "y": 334.2, "text": "c2);"}, {"page": 33, "x": 144.0, "y": 346.4, "text": "   friend ostream& operator<< (ostream& os, const CComplex& c);"}, {"page": 33, "x": 144.0, "y": 358.6, "text": "private:"}, {"page": 33, "x": 144.0, "y": 370.9, "text": "   double dReal;"}, {"page": 33, "x": 144.0, "y": 383.1, "text": "   double dImg;"}, {"page": 33, "x": 144.0, "y": 395.4, "text": "};"}, {"page": 33, "x": 144.0, "y": 419.8, "text": "CComplex operator+ (const CComplex& c1, const CComplex& c2)"}, {"page": 33, "x": 144.0, "y": 432.1, "text": "{"}, {"page": 33, "x": 144.0, "y": 444.3, "text": "   CComplex c(c1.dReal + c2.dReal, c1.dImg + c2.dImg);"}, {"page": 33, "x": 144.0, "y": 456.6, "text": "   return c;"}, {"page": 33, "x": 144.0, "y": 468.8, "text": "}"}, {"page": 33, "x": 144.0, "y": 481.0, "text": "ostream& operator<< ( ostream& os, const CComplex& c )"}, {"page": 33, "x": 144.0, "y": 493.3, "text": "{"}, {"page": 33, "x": 144.0, "y": 505.5, "text": "   return os<<c.dReal<< \"+\" <<c.dImg << \"i\";"}, {"page": 33, "x": 144.0, "y": 517.8, "text": "}"}, {"page": 33, "x": 144.0, "y": 542.2, "text": "int _tmain(int argc, TCHAR* argv[])"}, {"page": 33, "x": 144.0, "y": 554.5, "text": "{"}, {"page": 33, "x": 144.0, "y": 566.7, "text": "   CComplex c1;"}, {"page": 33, "x": 144.0, "y": 579.0, "text": "   CComplex c2(-2.3, 0.9);"}, {"page": 33, "x": 144.0, "y": 591.2, "text": "   CComplex c = c1 + c2;"}, {"page": 33, "x": 144.0, "y": 603.4, "text": "   cout << c << endl;"}, {"page": 33, "x": 144.0, "y": 627.9, "text": "   return 0;"}, {"page": 33, "x": 144.0, "y": 640.2, "text": "}"}, {"page": 34, "x": 126.0, "y": 463.5, "text": "friend CComplex operator+ (const CComplex& c1, const"}, {"page": 34, "x": 126.0, "y": 475.8, "text": "CComplex& c2);"}, {"page": 35, "x": 126.0, "y": 216.9, "text": "1.\t Create a new default console application. Name it InheritanceTest."}, {"page": 35, "x": 126.0, "y": 233.2, "text": "2.\t Open the InheritanceTest.cpp file and insert the following code:"}, {"page": 35, "x": 144.0, "y": 250.2, "text": "#include \"stdafx.h\""}, {"page": 35, "x": 144.0, "y": 262.4, "text": "#include <iostream>"}, {"page": 35, "x": 144.0, "y": 286.9, "text": "using namespace std;"}, {"page": 35, "x": 144.0, "y": 311.4, "text": "class CPerson"}, {"page": 35, "x": 144.0, "y": 323.6, "text": "{"}, {"page": 35, "x": 144.0, "y": 335.8, "text": "public:"}, {"page": 35, "x": 144.0, "y": 348.1, "text": "  CPerson(int iAge, char* sName)"}, {"page": 35, "x": 144.0, "y": 360.3, "text": "  {"}, {"page": 35, "x": 144.0, "y": 372.6, "text": "    this->iAge = iAge;"}, {"page": 35, "x": 144.0, "y": 384.8, "text": "    strcpy_s(this->sName, 32, sName);"}, {"page": 35, "x": 144.0, "y": 397.0, "text": "  }"}, {"page": 35, "x": 144.0, "y": 409.3, "text": "  virtual char* WhoAmI()"}, {"page": 35, "x": 144.0, "y": 421.5, "text": "  {"}, {"page": 35, "x": 144.0, "y": 433.8, "text": "    return \"I am a person\";"}, {"page": 35, "x": 144.0, "y": 446.0, "text": "  }"}, {"page": 35, "x": 144.0, "y": 458.2, "text": "private:"}, {"page": 35, "x": 144.0, "y": 470.5, "text": "  int iAge;"}, {"page": 35, "x": 144.0, "y": 482.7, "text": "  char sName[32];"}, {"page": 35, "x": 144.0, "y": 495.0, "text": "};"}, {"page": 35, "x": 144.0, "y": 519.4, "text": "class CWorker : public CPerson"}, {"page": 35, "x": 144.0, "y": 531.7, "text": "{"}, {"page": 35, "x": 144.0, "y": 543.9, "text": "public:"}, {"page": 35, "x": 144.0, "y": 556.2, "text": "  CWorker(int iAge, char* sName, char* sEmploymentStatus)"}, {"page": 35, "x": 144.0, "y": 568.4, "text": "    : CPerson(iAge, sName)"}, {"page": 35, "x": 144.0, "y": 580.6, "text": "  {"}, {"page": 35, "x": 144.0, "y": 592.9, "text": "    strcpy_s(this->sEmploymentStatus, 32, sEmploymentStatus);"}, {"page": 35, "x": 144.0, "y": 605.1, "text": "  }"}, {"page": 36, "x": 144.0, "y": 115.3, "text": "  virtual char* WhoAmI()"}, {"page": 36, "x": 144.0, "y": 127.5, "text": "  {"}, {"page": 36, "x": 144.0, "y": 139.8, "text": "    return \"I am a worker\";"}, {"page": 36, "x": 144.0, "y": 152.0, "text": "  }"}, {"page": 36, "x": 144.0, "y": 164.3, "text": "private:"}, {"page": 36, "x": 144.0, "y": 176.5, "text": "  char sEmploymentStatus[32];"}, {"page": 36, "x": 144.0, "y": 188.7, "text": "};"}, {"page": 36, "x": 144.0, "y": 213.2, "text": "class CStudent : public CPerson"}, {"page": 36, "x": 144.0, "y": 225.5, "text": "{"}, {"page": 36, "x": 144.0, "y": 237.7, "text": "public:"}, {"page": 36, "x": 144.0, "y": 249.9, "text": "  CStudent(int iAge, char* sName, char* sStudentIdentityCard)"}, {"page": 36, "x": 144.0, "y": 262.2, "text": "    : CPerson(iAge, sName)"}, {"page": 36, "x": 144.0, "y": 274.4, "text": "  {"}, {"page": 36, "x": 144.0, "y": 286.6, "text": "    strcpy_s(this->sStudentIdentityCard, 32,"}, {"page": 36, "x": 144.0, "y": 297.4, "text": "sStudentIdentityCard);"}, {"page": 36, "x": 144.0, "y": 309.7, "text": "  }"}, {"page": 36, "x": 144.0, "y": 321.9, "text": "  virtual char* WhoAmI()"}, {"page": 36, "x": 144.0, "y": 334.2, "text": "  {"}, {"page": 36, "x": 144.0, "y": 346.4, "text": "    return \"I am a student\";"}, {"page": 36, "x": 144.0, "y": 358.6, "text": "  }"}, {"page": 36, "x": 144.0, "y": 370.9, "text": "private:"}, {"page": 36, "x": 144.0, "y": 383.1, "text": "  char sStudentIdentityCard[32];"}, {"page": 36, "x": 144.0, "y": 395.4, "text": "};"}, {"page": 36, "x": 144.0, "y": 419.8, "text": "int _tmain(int argc, TCHAR* argv[])"}, {"page": 36, "x": 144.0, "y": 432.1, "text": "{"}, {"page": 36, "x": 144.0, "y": 444.3, "text": "  CPerson cPerson(10, \"John\");"}, {"page": 36, "x": 144.0, "y": 456.6, "text": "  cout << cPerson.WhoAmI() << endl;"}, {"page": 36, "x": 144.0, "y": 481.0, "text": "  CWorker cWorker(35, \"Mary\", \"On wacation\");"}, {"page": 36, "x": 144.0, "y": 493.3, "text": "  cout << cWorker.WhoAmI() << endl;"}, {"page": 36, "x": 144.0, "y": 517.8, "text": "  CStudent cStudent(22, \"Sandra\", \"Phisician\");"}, {"page": 36, "x": 144.0, "y": 530.0, "text": "  cout << cStudent.WhoAmI() << endl;"}, {"page": 36, "x": 144.0, "y": 554.5, "text": "  return 0;"}, {"page": 36, "x": 144.0, "y": 566.7, "text": "}"}, {"page": 37, "x": 126.0, "y": 213.4, "text": "class CWorker : public CPerson"}, {"page": 37, "x": 126.0, "y": 301.5, "text": "class CStudent : public CPerson"}, {"page": 37, "x": 126.0, "y": 377.6, "text": "CWorker( int iAge, char* sName, char* sEmploymentStatus )"}, {"page": 37, "x": 126.0, "y": 389.8, "text": ": CPerson( iAge, sName )"}, {"page": 37, "x": 126.0, "y": 402.1, "text": "{"}, {"page": 37, "x": 126.0, "y": 414.3, "text": "   strcpy_s( this->sEmploymentStatus, 32, sEmploymentStatus );"}, {"page": 37, "x": 126.0, "y": 426.6, "text": "}"}, {"page": 37, "x": 126.0, "y": 490.6, "text": "CPerson(iAge, sName)"}, {"page": 39, "x": 126.0, "y": 637.5, "text": "1.\t Create a new default console application. Name it PolymorphismTest."}, {"page": 40, "x": 126.0, "y": 114.8, "text": "2.\t Open the PolymorphismTest.cpp file and insert the following code:"}, {"page": 40, "x": 144.0, "y": 131.8, "text": "#include \"stdafx.h\""}, {"page": 40, "x": 144.0, "y": 144.0, "text": "#include <iostream>"}, {"page": 40, "x": 144.0, "y": 168.5, "text": "#define M_PI 3.14159265358979323846"}, {"page": 40, "x": 144.0, "y": 193.0, "text": "using namespace std;"}, {"page": 40, "x": 144.0, "y": 217.4, "text": "class CFigure"}, {"page": 40, "x": 144.0, "y": 229.7, "text": "{"}, {"page": 40, "x": 144.0, "y": 241.9, "text": "public:"}, {"page": 40, "x": 144.0, "y": 254.2, "text": "  virtual char* FigureType() = 0;"}, {"page": 40, "x": 144.0, "y": 266.4, "text": "  virtual double Circumference() = 0;"}, {"page": 40, "x": 144.0, "y": 278.6, "text": "  virtual double Area() = 0;"}, {"page": 40, "x": 144.0, "y": 290.9, "text": "  virtual ~CFigure(){ }"}, {"page": 40, "x": 144.0, "y": 303.1, "text": "};"}, {"page": 40, "x": 144.0, "y": 327.6, "text": "class CTriangle : public CFigure"}, {"page": 40, "x": 144.0, "y": 339.8, "text": "{"}, {"page": 40, "x": 144.0, "y": 352.1, "text": "public:"}, {"page": 40, "x": 144.0, "y": 364.3, "text": "  CTriangle()"}, {"page": 40, "x": 144.0, "y": 376.6, "text": "  {"}, {"page": 40, "x": 144.0, "y": 388.8, "text": "    a = b = c = 0;"}, {"page": 40, "x": 144.0, "y": 401.0, "text": "  }"}, {"page": 40, "x": 144.0, "y": 413.3, "text": "  CTriangle(double a, double b, double c) : a(a), b(b), c(c){ }"}, {"page": 40, "x": 144.0, "y": 425.5, "text": "  virtual char* FigureType()"}, {"page": 40, "x": 144.0, "y": 437.8, "text": "  {"}, {"page": 40, "x": 144.0, "y": 450.0, "text": "    return \"Triangle\";"}, {"page": 40, "x": 144.0, "y": 462.2, "text": "  }"}, {"page": 40, "x": 144.0, "y": 474.5, "text": "  virtual double Circumference()"}, {"page": 40, "x": 144.0, "y": 486.7, "text": "  {"}, {"page": 40, "x": 144.0, "y": 499.0, "text": "    return a + b + c;"}, {"page": 40, "x": 144.0, "y": 511.2, "text": "  }"}, {"page": 40, "x": 144.0, "y": 523.4, "text": "  virtual double Area()"}, {"page": 40, "x": 144.0, "y": 535.7, "text": "  {"}, {"page": 40, "x": 144.0, "y": 547.9, "text": "    double S = Circumference() / 2;"}, {"page": 40, "x": 144.0, "y": 560.2, "text": "    return sqrt(S * (S - a) * (S - b) * (S - c));"}, {"page": 40, "x": 144.0, "y": 572.4, "text": "  }"}, {"page": 40, "x": 144.0, "y": 584.6, "text": "private:"}, {"page": 40, "x": 144.0, "y": 596.9, "text": "  double a, b, c;"}, {"page": 40, "x": 144.0, "y": 609.1, "text": "};"}, {"page": 41, "x": 144.0, "y": 115.3, "text": "class CSquare : public CFigure"}, {"page": 41, "x": 144.0, "y": 127.5, "text": "{"}, {"page": 41, "x": 144.0, "y": 139.8, "text": "public:"}, {"page": 41, "x": 144.0, "y": 152.0, "text": "  CSquare()"}, {"page": 41, "x": 144.0, "y": 164.3, "text": "  {"}, {"page": 41, "x": 144.0, "y": 176.5, "text": "    a = b = 0;"}, {"page": 41, "x": 144.0, "y": 188.7, "text": "  }"}, {"page": 41, "x": 144.0, "y": 201.0, "text": "  CSquare(double a, double b) : a(a), b(b) { }"}, {"page": 41, "x": 144.0, "y": 213.2, "text": "  virtual char* FigureType()"}, {"page": 41, "x": 144.0, "y": 237.7, "text": "  {"}, {"page": 41, "x": 144.0, "y": 249.9, "text": "    return \"Square\";"}, {"page": 41, "x": 144.0, "y": 262.2, "text": "  }"}, {"page": 41, "x": 144.0, "y": 274.4, "text": "  virtual double Circumference()"}, {"page": 41, "x": 144.0, "y": 286.6, "text": "  {"}, {"page": 41, "x": 144.0, "y": 298.9, "text": "    return 2 * a + 2 * b;"}, {"page": 41, "x": 144.0, "y": 311.1, "text": "  }"}, {"page": 41, "x": 144.0, "y": 323.4, "text": "  virtual double Area()"}, {"page": 41, "x": 144.0, "y": 335.6, "text": "  {"}, {"page": 41, "x": 144.0, "y": 347.8, "text": "    return a * b;"}, {"page": 41, "x": 144.0, "y": 360.1, "text": "  }"}, {"page": 41, "x": 144.0, "y": 372.3, "text": "private:"}, {"page": 41, "x": 144.0, "y": 384.6, "text": "  double a, b;"}, {"page": 41, "x": 144.0, "y": 396.8, "text": "};"}, {"page": 41, "x": 144.0, "y": 416.5, "text": "class CCircle : public CFigure"}, {"page": 41, "x": 144.0, "y": 428.7, "text": "{"}, {"page": 41, "x": 144.0, "y": 441.0, "text": "public:"}, {"page": 41, "x": 144.0, "y": 453.2, "text": "  CCircle()"}, {"page": 41, "x": 144.0, "y": 465.4, "text": "  {"}, {"page": 41, "x": 144.0, "y": 477.7, "text": "    r = 0;"}, {"page": 41, "x": 144.0, "y": 489.9, "text": "  }"}, {"page": 41, "x": 144.0, "y": 502.2, "text": "  CCircle(double r) : r(r) { }"}, {"page": 41, "x": 144.0, "y": 514.4, "text": "  virtual char* FigureType()"}, {"page": 41, "x": 144.0, "y": 526.7, "text": "  {"}, {"page": 41, "x": 144.0, "y": 538.9, "text": "    return \"Circle\";"}, {"page": 41, "x": 144.0, "y": 551.1, "text": "  }"}, {"page": 41, "x": 144.0, "y": 563.4, "text": "  virtual double Circumference()"}, {"page": 41, "x": 144.0, "y": 575.6, "text": "  {"}, {"page": 41, "x": 144.0, "y": 587.8, "text": "    return 2 * r * M_PI;"}, {"page": 41, "x": 144.0, "y": 600.1, "text": "  }"}, {"page": 41, "x": 144.0, "y": 612.3, "text": "  virtual double Area()"}, {"page": 41, "x": 144.0, "y": 624.6, "text": "  {"}, {"page": 42, "x": 144.0, "y": 115.3, "text": "    return r * r * M_PI;"}, {"page": 42, "x": 144.0, "y": 127.5, "text": "  }"}, {"page": 42, "x": 144.0, "y": 139.8, "text": "private:"}, {"page": 42, "x": 144.0, "y": 152.0, "text": "  double r;"}, {"page": 42, "x": 144.0, "y": 164.3, "text": "};"}, {"page": 42, "x": 144.0, "y": 183.9, "text": "int _tmain(int argc, _TCHAR* argv[])"}, {"page": 42, "x": 144.0, "y": 196.2, "text": "{"}, {"page": 42, "x": 144.0, "y": 208.4, "text": "  CFigure* figures[3];"}, {"page": 42, "x": 144.0, "y": 228.1, "text": "  figures[0] = new CTriangle(2.1, 3.2, 4.3);"}, {"page": 42, "x": 144.0, "y": 240.3, "text": "  figures[1] = new CSquare(5.4, 6.5);"}, {"page": 42, "x": 144.0, "y": 252.6, "text": "  figures[2] = new CCircle(8.8);"}, {"page": 42, "x": 144.0, "y": 272.2, "text": "  for (int i = 0; i < 3; i++)"}, {"page": 42, "x": 144.0, "y": 284.5, "text": "  {"}, {"page": 42, "x": 144.0, "y": 296.7, "text": "    cout << \"Figure type:\\t\" << figures[i]->FigureType()"}, {"page": 42, "x": 144.0, "y": 309.0, "text": "      << \"\\nCircumference:\\t\" <<"}, {"page": 42, "x": 144.0, "y": 321.2, "text": "      figures[i]->Circumference()"}, {"page": 42, "x": 144.0, "y": 333.4, "text": "      << \"\\nArea:\\t\\t\" << figures[i]->Area()"}, {"page": 42, "x": 144.0, "y": 345.7, "text": "      << endl << endl;"}, {"page": 42, "x": 144.0, "y": 357.9, "text": "  }"}, {"page": 42, "x": 144.0, "y": 377.6, "text": "  return 0;"}, {"page": 42, "x": 144.0, "y": 389.8, "text": "}"}, {"page": 43, "x": 126.0, "y": 184.1, "text": "figures[ 0 ] = new CTriangle( 2.1, 3.2, 4.3 );"}, {"page": 43, "x": 126.0, "y": 224.2, "text": "figures[ 1 ] = new CSquare( 5.4, 6.5 );"}, {"page": 43, "x": 126.0, "y": 236.4, "text": "figures[ 2 ] = new CCircle( 8.8 );"}, {"page": 43, "x": 126.0, "y": 276.5, "text": "for ( int i = 0; i < 3; i++ )"}, {"page": 43, "x": 126.0, "y": 288.7, "text": "{"}, {"page": 43, "x": 126.0, "y": 301.0, "text": "   cout << \"Figure type:\\t\" << figures[ i ]->FigureType( )"}, {"page": 43, "x": 126.0, "y": 311.8, "text": "<< \"\\nCircumference:\\t\" << figures[ i ]->Circumference( )"}, {"page": 43, "x": 126.0, "y": 322.6, "text": "<< \"\\nArea:\\t\\t\" << figures[ i ]->Area( ) << endl<<endl;"}, {"page": 43, "x": 126.0, "y": 334.8, "text": "}"}, {"page": 43, "x": 126.0, "y": 443.5, "text": "cPerson.WhoAmI( )"}, {"page": 44, "x": 126.0, "y": 435.0, "text": "1.\t Create a new empty Win32 C++ project. Name it GUIProject, and then click on"}, {"page": 44, "x": 144.0, "y": 459.0, "text": "Explorer. Name it main, and then click on Add."}, {"page": 44, "x": 144.0, "y": 492.2, "text": "#include <windows.h>"}, {"page": 44, "x": 126.0, "y": 568.3, "text": "LRESULT CALLBACK WndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM"}, {"page": 44, "x": 126.0, "y": 580.6, "text": "lParam);"}, {"page": 45, "x": 126.0, "y": 160.1, "text": "int WINAPI WinMain(HINSTANCE hThis, HINSTANCE hPrev, LPSTR szCmdLine,"}, {"page": 45, "x": 126.0, "y": 170.9, "text": "int iCmdShow)"}, {"page": 45, "x": 126.0, "y": 404.3, "text": "UNREFERENCED_PARAMETER( hPrev );"}, {"page": 45, "x": 126.0, "y": 416.5, "text": "UNREFERENCED_PARAMETER( szCmdLine );"}, {"page": 45, "x": 126.0, "y": 492.6, "text": "WNDCLASSEX wndEx = { 0 };"}, {"page": 45, "x": 126.0, "y": 544.7, "text": "wndEx.cbClsExtra = 0;"}, {"page": 45, "x": 126.0, "y": 584.8, "text": "wndEx.cbSize = sizeof( wndEx );"}, {"page": 46, "x": 126.0, "y": 148.1, "text": "wndEx.cbWndExtra = 0;"}, {"page": 46, "x": 126.0, "y": 188.2, "text": "wndEx.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);"}, {"page": 46, "x": 126.0, "y": 228.2, "text": "wndEx.hCursor = LoadCursor( NULL, IDC_ARROW );"}, {"page": 46, "x": 126.0, "y": 268.3, "text": "wndEx.hIcon = LoadIcon( NULL, IDI_APPLICATION );"}, {"page": 46, "x": 126.0, "y": 280.6, "text": "wndEx.hIconSm = LoadIcon( NULL, IDI_APPLICATION );"}, {"page": 46, "x": 126.0, "y": 332.6, "text": "wndEx.hInstance = hThis;"}, {"page": 46, "x": 126.0, "y": 372.7, "text": "wndEx.lpfnWndProc = WndProc;"}, {"page": 46, "x": 126.0, "y": 412.8, "text": "wndEx.lpszClassName = TEXT(\"GUIProject\");"}, {"page": 46, "x": 126.0, "y": 464.9, "text": "wndEx.lpszMenuName = NULL;"}, {"page": 46, "x": 126.0, "y": 505.0, "text": "wndEx.style = CS_HREDRAW | CS_VREDRAW;"}, {"page": 46, "x": 126.0, "y": 557.0, "text": "if ( !RegisterClassEx( &wndEx ) )"}, {"page": 46, "x": 126.0, "y": 569.3, "text": "{"}, {"page": 46, "x": 126.0, "y": 581.5, "text": "  return -1;"}, {"page": 46, "x": 126.0, "y": 593.8, "text": "}"}, {"page": 47, "x": 126.0, "y": 172.1, "text": "HWND hWnd = CreateWindow( wndEx.lpszClassName, TEXT(\"GUI Project\"),"}, {"page": 47, "x": 126.0, "y": 182.9, "text": "WS_OVERLAPPEDWINDOW, 200, 200, 400, 300, HWND_DESKTOP,NULL, hThis, 0"}, {"page": 47, "x": 126.0, "y": 193.7, "text": ");"}, {"page": 47, "x": 126.0, "y": 218.2, "text": "if ( !hWnd )"}, {"page": 47, "x": 126.0, "y": 230.4, "text": "{"}, {"page": 47, "x": 126.0, "y": 242.6, "text": "   return -1;"}, {"page": 47, "x": 126.0, "y": 254.9, "text": "}"}, {"page": 47, "x": 126.0, "y": 331.0, "text": "UpdateWindow( hWnd );"}, {"page": 47, "x": 126.0, "y": 371.0, "text": "ShowWindow( hWnd, iCmdShow );"}, {"page": 47, "x": 126.0, "y": 411.1, "text": "MSG msg = { 0 };"}, {"page": 47, "x": 126.0, "y": 523.2, "text": "while ( GetMessage( &msg, NULL, NULL, NULL ) )"}, {"page": 47, "x": 126.0, "y": 535.4, "text": "{"}, {"page": 47, "x": 126.0, "y": 547.7, "text": "   // Translates virtual-key messages into character messages."}, {"page": 47, "x": 126.0, "y": 559.9, "text": "   TranslateMessage(&msg );"}, {"page": 47, "x": 126.0, "y": 572.2, "text": "   // Dispatches a message to a window procedure."}, {"page": 47, "x": 126.0, "y": 584.4, "text": "   DispatchMessage(&msg );"}, {"page": 47, "x": 126.0, "y": 596.6, "text": "}"}, {"page": 48, "x": 126.0, "y": 208.1, "text": "DestroyWindow( hWnd );"}, {"page": 48, "x": 126.0, "y": 248.2, "text": "UnregisterClass( wndEx.lpszClassName, hThis );"}, {"page": 48, "x": 126.0, "y": 300.2, "text": "return (int) msg.wParam;"}, {"page": 48, "x": 126.0, "y": 412.3, "text": "LRESULT CALLBACK WndProc( HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM"}, {"page": 48, "x": 126.0, "y": 423.1, "text": "lParam )"}, {"page": 48, "x": 126.0, "y": 435.4, "text": "{"}, {"page": 48, "x": 126.0, "y": 511.4, "text": "switch ( uMsg )"}, {"page": 48, "x": 126.0, "y": 523.7, "text": "{"}, {"page": 48, "x": 126.0, "y": 535.9, "text": "   case WM_CLOSE:"}, {"page": 48, "x": 126.0, "y": 548.2, "text": "   {"}, {"page": 48, "x": 126.0, "y": 560.4, "text": "       PostQuitMessage( 0 );"}, {"page": 48, "x": 126.0, "y": 572.6, "text": "       break;"}, {"page": 48, "x": 126.0, "y": 584.9, "text": "   }"}, {"page": 48, "x": 126.0, "y": 609.4, "text": "   default:"}, {"page": 48, "x": 126.0, "y": 621.6, "text": "   {"}, {"page": 49, "x": 126.0, "y": 160.1, "text": "           return DefWindowProc(hWnd, uMsg, wParam, lParam);"}, {"page": 49, "x": 126.0, "y": 172.3, "text": "        }"}, {"page": 49, "x": 126.0, "y": 184.6, "text": "    }"}, {"page": 49, "x": 126.0, "y": 196.8, "text": "    return 0;"}, {"page": 49, "x": 126.0, "y": 209.0, "text": "}"}, {"page": 50, "x": 126.0, "y": 216.9, "text": "1.\t Create a new empty C++ console application project. Name it LinkedList."}, {"page": 50, "x": 126.0, "y": 233.2, "text": "2.\t Add a new header file named CList.h. Copy and paste the following code into it:"}, {"page": 50, "x": 144.0, "y": 250.2, "text": "#ifndef _LIST_"}, {"page": 50, "x": 144.0, "y": 262.4, "text": "#define _LIST_"}, {"page": 50, "x": 144.0, "y": 286.9, "text": "#include <Windows.h>"}, {"page": 50, "x": 144.0, "y": 311.4, "text": "template <class T>"}, {"page": 50, "x": 144.0, "y": 323.6, "text": "class CNode"}, {"page": 50, "x": 144.0, "y": 335.8, "text": "{"}, {"page": 50, "x": 144.0, "y": 348.1, "text": "public:"}, {"page": 50, "x": 144.0, "y": 360.3, "text": "  CNode(T* tElement) : tElement(tElement), next(0) { }"}, {"page": 50, "x": 144.0, "y": 372.6, "text": "  T* Element() const { return tElement; }"}, {"page": 50, "x": 144.0, "y": 384.8, "text": "  CNode*& Next(){ return next; }"}, {"page": 50, "x": 144.0, "y": 397.0, "text": "private:"}, {"page": 50, "x": 144.0, "y": 409.3, "text": "  T* tElement;"}, {"page": 50, "x": 144.0, "y": 421.5, "text": "  CNode* next;"}, {"page": 50, "x": 144.0, "y": 433.8, "text": "};"}, {"page": 50, "x": 144.0, "y": 458.2, "text": "template <class T>"}, {"page": 50, "x": 144.0, "y": 470.5, "text": "class CList"}, {"page": 50, "x": 144.0, "y": 482.7, "text": "{"}, {"page": 50, "x": 144.0, "y": 495.0, "text": "public:"}, {"page": 50, "x": 144.0, "y": 507.2, "text": "  CList() : dwCount(0), head(0){ }"}, {"page": 50, "x": 144.0, "y": 519.4, "text": "  CList(T* tElement) : dwCount(1), head(new CNode<T>(tElement)){ }"}, {"page": 50, "x": 144.0, "y": 531.7, "text": "  virtual ~CList(){ }"}, {"page": 50, "x": 144.0, "y": 543.9, "text": "  void Append(CNode<T>*& node, T* tElement);"}, {"page": 50, "x": 144.0, "y": 556.2, "text": "  void Insert(T* tElement);"}, {"page": 50, "x": 144.0, "y": 568.4, "text": "  bool Remove(T* tElement);"}, {"page": 50, "x": 144.0, "y": 580.6, "text": "  DWORD Count() const { return dwCount; }"}, {"page": 50, "x": 144.0, "y": 592.9, "text": "  CNode<T>*& Head() { return head; }"}, {"page": 50, "x": 144.0, "y": 605.1, "text": "  T* GetFirst(){ return head != NULL ? head->Element() : NULL; }"}, {"page": 50, "x": 144.0, "y": 617.4, "text": "  T* GetLast();"}, {"page": 51, "x": 144.0, "y": 115.3, "text": "  T* GetNext(T* tElement);"}, {"page": 51, "x": 144.0, "y": 127.5, "text": "  T* Find(DWORD(*Function)(T* tParameter), DWORD dwValue);"}, {"page": 51, "x": 144.0, "y": 139.8, "text": "protected:"}, {"page": 51, "x": 144.0, "y": 152.0, "text": "  CList(const CList& list);"}, {"page": 51, "x": 144.0, "y": 164.3, "text": "  CList& operator = (const CList& list);"}, {"page": 51, "x": 144.0, "y": 176.5, "text": "private:"}, {"page": 51, "x": 144.0, "y": 188.7, "text": "  CNode<T>* head;"}, {"page": 51, "x": 144.0, "y": 201.0, "text": "  DWORD dwCount;"}, {"page": 51, "x": 144.0, "y": 213.2, "text": "};"}, {"page": 51, "x": 144.0, "y": 237.7, "text": "template <class T>"}, {"page": 51, "x": 144.0, "y": 249.9, "text": "void CList<T>::Append(CNode<T>*& node, T* tElement)"}, {"page": 51, "x": 144.0, "y": 262.2, "text": "{"}, {"page": 51, "x": 144.0, "y": 274.4, "text": "    if (node == NULL)"}, {"page": 51, "x": 144.0, "y": 286.6, "text": "    {"}, {"page": 51, "x": 144.0, "y": 298.9, "text": "       dwCount++;"}, {"page": 51, "x": 144.0, "y": 311.1, "text": "       node = new CNode<T>(tElement);"}, {"page": 51, "x": 144.0, "y": 335.6, "text": "       return;"}, {"page": 51, "x": 144.0, "y": 347.8, "text": "    }"}, {"page": 51, "x": 144.0, "y": 372.3, "text": "    Append(node->Next(), tElement);"}, {"page": 51, "x": 144.0, "y": 384.6, "text": "}"}, {"page": 51, "x": 144.0, "y": 409.0, "text": "template <class T>"}, {"page": 51, "x": 144.0, "y": 421.3, "text": "void CList<T>::Insert(T* tElement)"}, {"page": 51, "x": 144.0, "y": 433.5, "text": "{"}, {"page": 51, "x": 144.0, "y": 445.8, "text": "    dwCount++;"}, {"page": 51, "x": 144.0, "y": 458.0, "text": "    if (head == NULL)"}, {"page": 51, "x": 144.0, "y": 470.2, "text": "    {"}, {"page": 51, "x": 144.0, "y": 482.5, "text": "       head = new CNode<T>(tElement);"}, {"page": 51, "x": 144.0, "y": 494.7, "text": "       return;"}, {"page": 51, "x": 144.0, "y": 507.0, "text": "    }"}, {"page": 51, "x": 144.0, "y": 531.4, "text": "    CNode<T>* tmp = head;"}, {"page": 51, "x": 144.0, "y": 543.7, "text": "    head = new CNode<T>(tElement);"}, {"page": 51, "x": 144.0, "y": 555.9, "text": "    head->Next() = tmp;"}, {"page": 51, "x": 144.0, "y": 568.2, "text": "}"}, {"page": 51, "x": 144.0, "y": 592.7, "text": "template <class T>"}, {"page": 51, "x": 144.0, "y": 604.9, "text": "bool CList<T>::Remove(T* tElement)"}, {"page": 51, "x": 144.0, "y": 617.1, "text": "{"}, {"page": 51, "x": 144.0, "y": 629.4, "text": "    if (head == NULL)"}, {"page": 51, "x": 144.0, "y": 641.6, "text": "    {"}, {"page": 52, "x": 144.0, "y": 115.3, "text": "       return NULL;"}, {"page": 52, "x": 144.0, "y": 127.5, "text": "    }"}, {"page": 52, "x": 144.0, "y": 152.0, "text": "    if (head->Element() == tElement)"}, {"page": 52, "x": 144.0, "y": 164.3, "text": "    {"}, {"page": 52, "x": 144.0, "y": 176.5, "text": "       CNode<T>* tmp = head;"}, {"page": 52, "x": 144.0, "y": 188.7, "text": "       head = head->Next();"}, {"page": 52, "x": 144.0, "y": 213.2, "text": "       delete tmp;"}, {"page": 52, "x": 144.0, "y": 225.5, "text": "       dwCount--;"}, {"page": 52, "x": 144.0, "y": 249.9, "text": "       return true;"}, {"page": 52, "x": 144.0, "y": 262.2, "text": "    }"}, {"page": 52, "x": 144.0, "y": 286.6, "text": "    CNode<T>* tmp = head;"}, {"page": 52, "x": 144.0, "y": 298.9, "text": "    CNode<T>* lst = head->Next();"}, {"page": 52, "x": 144.0, "y": 323.4, "text": "    while (lst != NULL)"}, {"page": 52, "x": 144.0, "y": 335.6, "text": "    {"}, {"page": 52, "x": 144.0, "y": 347.8, "text": "        if (lst->Element() == tElement)"}, {"page": 52, "x": 144.0, "y": 360.1, "text": "        {"}, {"page": 52, "x": 144.0, "y": 372.3, "text": "           tmp->Next() = lst->Next();"}, {"page": 52, "x": 144.0, "y": 396.8, "text": "           delete lst;"}, {"page": 52, "x": 144.0, "y": 409.0, "text": "           dwCount--;"}, {"page": 52, "x": 144.0, "y": 433.5, "text": "           return true;"}, {"page": 52, "x": 144.0, "y": 445.8, "text": "       }"}, {"page": 52, "x": 144.0, "y": 470.2, "text": "       lst = lst->Next();"}, {"page": 52, "x": 144.0, "y": 482.5, "text": "       tmp = tmp->Next();"}, {"page": 52, "x": 144.0, "y": 494.7, "text": "    }"}, {"page": 52, "x": 144.0, "y": 519.2, "text": "    return false;"}, {"page": 52, "x": 144.0, "y": 531.4, "text": "}"}, {"page": 52, "x": 144.0, "y": 555.9, "text": "template <class T>"}, {"page": 52, "x": 144.0, "y": 568.2, "text": "T* CList<T>::GetLast()"}, {"page": 52, "x": 144.0, "y": 580.4, "text": "{"}, {"page": 52, "x": 144.0, "y": 592.7, "text": "    if (head)"}, {"page": 52, "x": 144.0, "y": 604.9, "text": "    {"}, {"page": 52, "x": 144.0, "y": 617.1, "text": "       CNode<T>* tmp = head;"}, {"page": 52, "x": 144.0, "y": 629.4, "text": "       while (tmp->Next())"}, {"page": 52, "x": 144.0, "y": 641.6, "text": "       {"}, {"page": 53, "x": 144.0, "y": 115.3, "text": "          tmp = tmp->Next();"}, {"page": 53, "x": 144.0, "y": 127.5, "text": "       }"}, {"page": 53, "x": 144.0, "y": 139.8, "text": "       return tmp->Element();"}, {"page": 53, "x": 144.0, "y": 152.0, "text": "    }"}, {"page": 53, "x": 144.0, "y": 176.5, "text": "    return NULL;"}, {"page": 53, "x": 144.0, "y": 188.7, "text": "}"}, {"page": 53, "x": 144.0, "y": 213.2, "text": "template <class T>"}, {"page": 53, "x": 144.0, "y": 225.5, "text": "T* CList<T>::GetNext(T* tElement)"}, {"page": 53, "x": 144.0, "y": 237.7, "text": "{"}, {"page": 53, "x": 144.0, "y": 249.9, "text": "    if (head == NULL)"}, {"page": 53, "x": 144.0, "y": 262.2, "text": "    {"}, {"page": 53, "x": 144.0, "y": 274.4, "text": "       return NULL;"}, {"page": 53, "x": 144.0, "y": 286.6, "text": "    }"}, {"page": 53, "x": 144.0, "y": 311.1, "text": "    if (tElement == NULL)"}, {"page": 53, "x": 144.0, "y": 323.4, "text": "    {"}, {"page": 53, "x": 144.0, "y": 335.6, "text": "       return GetFirst();"}, {"page": 53, "x": 144.0, "y": 347.8, "text": "    }"}, {"page": 53, "x": 144.0, "y": 372.3, "text": "    if (head->Element() == tElement)"}, {"page": 53, "x": 144.0, "y": 384.6, "text": "    {"}, {"page": 53, "x": 144.0, "y": 396.8, "text": "       return head->Next() != NULL ? head->Next()->Element() :"}, {"page": 53, "x": 144.0, "y": 407.6, "text": "NULL;"}, {"page": 53, "x": 144.0, "y": 419.8, "text": "    }"}, {"page": 53, "x": 144.0, "y": 444.3, "text": "    CNode<T>* lst = head->Next();"}, {"page": 53, "x": 144.0, "y": 456.6, "text": "    while (lst != NULL)"}, {"page": 53, "x": 144.0, "y": 468.8, "text": "    {"}, {"page": 53, "x": 144.0, "y": 481.0, "text": "       if (lst->Element() == tElement)"}, {"page": 53, "x": 144.0, "y": 493.3, "text": "       {"}, {"page": 53, "x": 144.0, "y": 505.5, "text": "          return lst->Next() != NULL ? lst->Next()->Element() :"}, {"page": 53, "x": 144.0, "y": 516.3, "text": "NULL;"}, {"page": 53, "x": 144.0, "y": 528.6, "text": "       }"}, {"page": 53, "x": 144.0, "y": 553.0, "text": "       lst = lst->Next();"}, {"page": 53, "x": 144.0, "y": 565.3, "text": "    }"}, {"page": 53, "x": 144.0, "y": 589.8, "text": "    return NULL;"}, {"page": 53, "x": 144.0, "y": 602.0, "text": "}"}, {"page": 53, "x": 144.0, "y": 626.5, "text": "template <class T>"}, {"page": 53, "x": 144.0, "y": 638.7, "text": "T* CList<T>::Find(DWORD(*Function)(T* tParameter), DWORD dwValue)"}, {"page": 54, "x": 144.0, "y": 115.3, "text": "{"}, {"page": 54, "x": 144.0, "y": 127.5, "text": "    try"}, {"page": 54, "x": 144.0, "y": 139.8, "text": "    {"}, {"page": 54, "x": 144.0, "y": 152.0, "text": "       T* tElement = NULL;"}, {"page": 54, "x": 144.0, "y": 164.3, "text": "       while (tElement = GetNext(tElement))"}, {"page": 54, "x": 144.0, "y": 176.5, "text": "       {"}, {"page": 54, "x": 144.0, "y": 188.7, "text": "           if (Function(tElement) == dwValue)"}, {"page": 54, "x": 144.0, "y": 201.0, "text": "           {"}, {"page": 54, "x": 144.0, "y": 213.2, "text": "              return tElement;"}, {"page": 54, "x": 144.0, "y": 225.5, "text": "           }"}, {"page": 54, "x": 144.0, "y": 237.7, "text": "       }"}, {"page": 54, "x": 144.0, "y": 249.9, "text": "    }"}, {"page": 54, "x": 144.0, "y": 262.2, "text": "    catch (...) { }"}, {"page": 54, "x": 144.0, "y": 286.6, "text": "    return NULL;"}, {"page": 54, "x": 144.0, "y": 298.9, "text": "}"}, {"page": 54, "x": 144.0, "y": 323.4, "text": "#endif"}, {"page": 54, "x": 126.0, "y": 342.2, "text": "3.\t The provided files contain definitions and implementations of the CList class. Now,"}, {"page": 54, "x": 144.0, "y": 354.2, "text": "we can create CQueue and CStack very easily. Under the header files, create a new"}, {"page": 54, "x": 144.0, "y": 366.2, "text": "header file named CQueue.h and insert the following code:"}, {"page": 54, "x": 144.0, "y": 383.1, "text": "#ifndef __QUEUE__"}, {"page": 54, "x": 144.0, "y": 395.4, "text": "#define __QUEUE__"}, {"page": 54, "x": 144.0, "y": 419.8, "text": "#include \"CList.h\""}, {"page": 54, "x": 144.0, "y": 444.3, "text": "template<class T>"}, {"page": 54, "x": 144.0, "y": 456.6, "text": "class CQueue : CList<T>"}, {"page": 54, "x": 144.0, "y": 468.8, "text": "{"}, {"page": 54, "x": 144.0, "y": 481.0, "text": "public:"}, {"page": 54, "x": 144.0, "y": 493.3, "text": "  CQueue() : CList<T>(){ }"}, {"page": 54, "x": 144.0, "y": 505.5, "text": "  CQueue(T* tElement) : CList<T>(tElement){ }"}, {"page": 54, "x": 144.0, "y": 517.8, "text": "  virtual ~CQueue(){ }"}, {"page": 54, "x": 144.0, "y": 530.0, "text": "  virtual void Enqueue(T* tElement)"}, {"page": 54, "x": 144.0, "y": 542.2, "text": "  {"}, {"page": 54, "x": 144.0, "y": 554.5, "text": "    Append(Head(), tElement);"}, {"page": 54, "x": 144.0, "y": 566.7, "text": "  }"}, {"page": 54, "x": 144.0, "y": 579.0, "text": "  virtual T* Dequeue()"}, {"page": 54, "x": 144.0, "y": 591.2, "text": "  {"}, {"page": 54, "x": 144.0, "y": 603.4, "text": "    T* tElement = GetFirst();"}, {"page": 54, "x": 144.0, "y": 615.7, "text": "    Remove(tElement);"}, {"page": 54, "x": 144.0, "y": 627.9, "text": "    return tElement;"}, {"page": 54, "x": 144.0, "y": 640.2, "text": "  }"}, {"page": 55, "x": 144.0, "y": 115.3, "text": "  virtual T* Peek()"}, {"page": 55, "x": 144.0, "y": 127.5, "text": "  {"}, {"page": 55, "x": 144.0, "y": 139.8, "text": "    return GetFirst();"}, {"page": 55, "x": 144.0, "y": 152.0, "text": "  }"}, {"page": 55, "x": 144.0, "y": 164.3, "text": "  CList<T>::Count;"}, {"page": 55, "x": 144.0, "y": 176.5, "text": "protected:"}, {"page": 55, "x": 144.0, "y": 188.7, "text": "  CQueue(const CQueue<T>& cQueue);"}, {"page": 55, "x": 144.0, "y": 201.0, "text": "  CQueue<T>& operator = (const CQueue<T>& cQueue);"}, {"page": 55, "x": 144.0, "y": 213.2, "text": "};"}, {"page": 55, "x": 144.0, "y": 232.9, "text": "#endif"}, {"page": 55, "x": 126.0, "y": 251.7, "text": "4.\t For CStack, we will do something similar. Under the header files, create a new"}, {"page": 55, "x": 144.0, "y": 263.7, "text": "header file named CStack.h and insert the following code:"}, {"page": 55, "x": 144.0, "y": 280.6, "text": "#ifndef __STACK__"}, {"page": 55, "x": 144.0, "y": 292.5, "text": "#define __STACK__"}, {"page": 55, "x": 144.0, "y": 304.4, "text": "#include \"CList.h\""}, {"page": 55, "x": 144.0, "y": 323.4, "text": "template<class T>"}, {"page": 55, "x": 144.0, "y": 335.2, "text": "class CStack : CList<T>"}, {"page": 55, "x": 144.0, "y": 347.1, "text": "{"}, {"page": 55, "x": 144.0, "y": 359.0, "text": "public:"}, {"page": 55, "x": 144.0, "y": 370.9, "text": "  CStack() : CList<T>(){ }"}, {"page": 55, "x": 144.0, "y": 382.8, "text": "  CStack(T* tElement) : CList<T>(tElement){ }"}, {"page": 55, "x": 144.0, "y": 394.6, "text": "  virtual ~CStack(){ }"}, {"page": 55, "x": 144.0, "y": 406.5, "text": "  virtual void Push(T* tElement)"}, {"page": 55, "x": 144.0, "y": 418.4, "text": "  {"}, {"page": 55, "x": 144.0, "y": 430.3, "text": "    Insert(tElement);"}, {"page": 55, "x": 144.0, "y": 442.2, "text": "  }"}, {"page": 55, "x": 144.0, "y": 454.0, "text": "  virtual T* Pop()"}, {"page": 55, "x": 144.0, "y": 465.9, "text": "  {"}, {"page": 55, "x": 144.0, "y": 477.8, "text": "    T* tElement = GetFirst();"}, {"page": 55, "x": 144.0, "y": 489.7, "text": "    Remove(tElement);"}, {"page": 55, "x": 144.0, "y": 501.6, "text": "    return tElement;"}, {"page": 55, "x": 144.0, "y": 513.4, "text": "  }"}, {"page": 55, "x": 144.0, "y": 525.3, "text": "  virtual T* Peek()"}, {"page": 55, "x": 144.0, "y": 537.2, "text": "  {"}, {"page": 55, "x": 144.0, "y": 549.1, "text": "    return GetFirst();"}, {"page": 55, "x": 144.0, "y": 561.0, "text": "  }"}, {"page": 55, "x": 144.0, "y": 572.8, "text": "  CList<T>::Count;"}, {"page": 55, "x": 144.0, "y": 584.7, "text": "protected:"}, {"page": 55, "x": 144.0, "y": 596.6, "text": "  CStack(const CStack<T>& cStack);"}, {"page": 55, "x": 144.0, "y": 608.5, "text": "  CStack<T>& operator = (const CStack<T>& cStack);"}, {"page": 55, "x": 144.0, "y": 620.4, "text": "};"}, {"page": 55, "x": 144.0, "y": 639.3, "text": "#endif"}, {"page": 56, "x": 126.0, "y": 114.8, "text": "5.\t Finally, let's implement the following code in LinkedList.cpp, our placeholder"}, {"page": 56, "x": 144.0, "y": 143.8, "text": "#include <iostream>"}, {"page": 56, "x": 144.0, "y": 165.8, "text": "using namespace std;"}, {"page": 56, "x": 144.0, "y": 187.9, "text": "#include \"CQueue.h\""}, {"page": 56, "x": 144.0, "y": 200.2, "text": "#include \"CStack.h\""}, {"page": 56, "x": 144.0, "y": 222.2, "text": "int main()"}, {"page": 56, "x": 144.0, "y": 234.5, "text": "{"}, {"page": 56, "x": 144.0, "y": 246.7, "text": "  CQueue<int>* cQueue = new CQueue<int>();"}, {"page": 56, "x": 144.0, "y": 259.0, "text": "  CStack<double>* cStack = new CStack<double>();"}, {"page": 56, "x": 144.0, "y": 281.0, "text": "  for (int i = 0; i < 10; i++)"}, {"page": 56, "x": 144.0, "y": 293.3, "text": "  {"}, {"page": 56, "x": 144.0, "y": 305.5, "text": "    cQueue->Enqueue(new int(i));"}, {"page": 56, "x": 144.0, "y": 317.8, "text": "    cStack->Push(new double(i / 10.0));"}, {"page": 56, "x": 144.0, "y": 330.0, "text": "  }"}, {"page": 56, "x": 144.0, "y": 354.5, "text": "  cout << \"Queue - integer collection:\" << endl;"}, {"page": 56, "x": 144.0, "y": 366.7, "text": "  for (; cQueue->Count();)"}, {"page": 56, "x": 144.0, "y": 379.0, "text": "  {"}, {"page": 56, "x": 144.0, "y": 391.2, "text": "    cout << *cQueue->Dequeue() << \" \";"}, {"page": 56, "x": 144.0, "y": 403.4, "text": "  }"}, {"page": 56, "x": 144.0, "y": 427.9, "text": "  cout << endl << endl << \"Stack - double collection:\" << endl;"}, {"page": 56, "x": 144.0, "y": 440.2, "text": "  for (; cStack->Count();)"}, {"page": 56, "x": 144.0, "y": 452.4, "text": "  {"}, {"page": 56, "x": 144.0, "y": 464.6, "text": "    cout << *cStack->Pop() << \" \";"}, {"page": 56, "x": 144.0, "y": 476.9, "text": "  }"}, {"page": 56, "x": 144.0, "y": 501.4, "text": "  delete cQueue;"}, {"page": 56, "x": 144.0, "y": 513.6, "text": "  delete cStack;"}, {"page": 56, "x": 144.0, "y": 538.1, "text": "  cout << endl << endl;"}, {"page": 56, "x": 144.0, "y": 550.3, "text": "  return system(\"pause\");"}, {"page": 56, "x": 144.0, "y": 562.6, "text": "}"}, {"page": 57, "x": 126.0, "y": 455.4, "text": "#include <windows.h>"}, {"page": 57, "x": 126.0, "y": 467.6, "text": "#include \"CList.h\""}, {"page": 57, "x": 126.0, "y": 492.1, "text": "class CStudent"}, {"page": 57, "x": 126.0, "y": 504.3, "text": "{"}, {"page": 57, "x": 126.0, "y": 516.6, "text": "public:"}, {"page": 57, "x": 126.0, "y": 528.8, "text": "  CStudent(DWORD dwStudentId) : dwStudentId(dwStudentId){ }"}, {"page": 57, "x": 126.0, "y": 541.0, "text": "  static DWORD GetStudentId(CStudent* student)"}, {"page": 57, "x": 126.0, "y": 553.3, "text": "  {"}, {"page": 57, "x": 126.0, "y": 565.5, "text": "    DWORD dwValue = student->GetId();"}, {"page": 57, "x": 126.0, "y": 577.8, "text": "    return dwValue;"}, {"page": 57, "x": 126.0, "y": 590.0, "text": "  }"}, {"page": 57, "x": 126.0, "y": 602.2, "text": "  DWORD GetId() const"}, {"page": 57, "x": 126.0, "y": 614.5, "text": "  {"}, {"page": 57, "x": 126.0, "y": 626.7, "text": "    return dwStudentId;"}, {"page": 57, "x": 126.0, "y": 639.0, "text": "  }"}, {"page": 58, "x": 126.0, "y": 115.3, "text": "private:"}, {"page": 58, "x": 126.0, "y": 127.5, "text": "  DWORD dwStudentId;"}, {"page": 58, "x": 126.0, "y": 139.8, "text": "};"}, {"page": 58, "x": 126.0, "y": 164.3, "text": "int main()"}, {"page": 58, "x": 126.0, "y": 176.5, "text": "{"}, {"page": 58, "x": 126.0, "y": 188.7, "text": "  CList<CStudent>* list = new CList<CStudent>();"}, {"page": 58, "x": 126.0, "y": 201.0, "text": "  list->Insert(new CStudent(1));"}, {"page": 58, "x": 126.0, "y": 213.2, "text": "  list->Insert(new CStudent(2));"}, {"page": 58, "x": 126.0, "y": 225.5, "text": "  list->Insert(new CStudent(3));"}, {"page": 58, "x": 126.0, "y": 249.9, "text": "  CStudent* s = list->Find(&CStudent::GetStudentId, 2);"}, {"page": 58, "x": 126.0, "y": 262.2, "text": "  if (s != NULL)"}, {"page": 58, "x": 126.0, "y": 274.4, "text": "  {"}, {"page": 58, "x": 126.0, "y": 286.6, "text": "    // s FOUND"}, {"page": 58, "x": 126.0, "y": 298.9, "text": "  }"}, {"page": 58, "x": 126.0, "y": 323.4, "text": "  return 0;"}, {"page": 58, "x": 126.0, "y": 335.6, "text": "}"}, {"page": 58, "x": 126.0, "y": 375.7, "text": "#include <windows.h>"}, {"page": 58, "x": 126.0, "y": 387.9, "text": "#include \"CList.h\""}, {"page": 58, "x": 126.0, "y": 412.4, "text": "DWORD Predicate(int* iElement)"}, {"page": 58, "x": 126.0, "y": 424.6, "text": "{"}, {"page": 58, "x": 126.0, "y": 436.9, "text": "  return (DWORD)(*iElement);"}, {"page": 58, "x": 126.0, "y": 449.1, "text": "}"}, {"page": 58, "x": 126.0, "y": 473.6, "text": "int main()"}, {"page": 58, "x": 126.0, "y": 485.8, "text": "{"}, {"page": 58, "x": 126.0, "y": 498.1, "text": "  CList<int>* list = new CList<int>();"}, {"page": 58, "x": 126.0, "y": 510.3, "text": "  list->Insert(new int(1));"}, {"page": 58, "x": 126.0, "y": 522.6, "text": "  list->Insert(new int(2));"}, {"page": 58, "x": 126.0, "y": 534.8, "text": "  list->Insert(new int(3));"}, {"page": 58, "x": 126.0, "y": 559.3, "text": "  int* iElement = list->Find(Predicate, 2);"}, {"page": 58, "x": 126.0, "y": 571.5, "text": "  if (iElement != NULL)"}, {"page": 58, "x": 126.0, "y": 583.8, "text": "  {"}, {"page": 58, "x": 126.0, "y": 596.0, "text": "    // iElement FOUND"}, {"page": 58, "x": 126.0, "y": 608.2, "text": "  }"}, {"page": 58, "x": 126.0, "y": 632.7, "text": "  return 0;"}, {"page": 58, "x": 126.0, "y": 645.0, "text": "}"}]