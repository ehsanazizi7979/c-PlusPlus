[{"page": 325, "x": 126.0, "y": 481.4, "text": "int iValue = 5;"}, {"page": 325, "x": 126.0, "y": 493.7, "text": "\u2026"}, {"page": 325, "x": 126.0, "y": 505.9, "text": "int iAValue = iValue;"}, {"page": 325, "x": 126.0, "y": 518.2, "text": "\u2026"}, {"page": 325, "x": 126.0, "y": 530.4, "text": "int iBValue = iValue;"}, {"page": 326, "x": 126.0, "y": 172.1, "text": "class Clock"}, {"page": 326, "x": 126.0, "y": 184.3, "text": "{"}, {"page": 326, "x": 126.0, "y": 196.6, "text": "public:"}, {"page": 326, "x": 126.0, "y": 208.8, "text": "  CLock( TCHAR* szMutexName );"}, {"page": 326, "x": 126.0, "y": 221.0, "text": "  ~CLock( );"}, {"page": 326, "x": 126.0, "y": 233.3, "text": "private:"}, {"page": 326, "x": 126.0, "y": 245.5, "text": "  HANDLE hMutex;"}, {"page": 326, "x": 126.0, "y": 257.8, "text": "};"}, {"page": 326, "x": 126.0, "y": 270.0, "text": "CLock::CLock( TCHAR* szMutexName )"}, {"page": 326, "x": 126.0, "y": 282.2, "text": "{"}, {"page": 326, "x": 126.0, "y": 294.5, "text": "  hMutex = CreateMutex( NULL, FALSE, szMutexName );"}, {"page": 326, "x": 126.0, "y": 306.7, "text": "  WaitForSingleObject( hMutex, INFINITE );"}, {"page": 326, "x": 126.0, "y": 319.0, "text": "}"}, {"page": 326, "x": 126.0, "y": 331.2, "text": "CLock::~CLock( )"}, {"page": 326, "x": 126.0, "y": 343.4, "text": "{"}, {"page": 326, "x": 126.0, "y": 355.7, "text": "  ReleaseMutex( hMutex );"}, {"page": 326, "x": 126.0, "y": 367.9, "text": "  CloseHandle( hMutex );"}, {"page": 326, "x": 126.0, "y": 380.2, "text": "}"}, {"page": 326, "x": 126.0, "y": 392.4, "text": "\u2026"}, {"page": 326, "x": 126.0, "y": 404.6, "text": "int iValue = 5;"}, {"page": 326, "x": 126.0, "y": 416.9, "text": "void funcA( void )"}, {"page": 326, "x": 126.0, "y": 429.1, "text": "{"}, {"page": 326, "x": 126.0, "y": 441.4, "text": "  CLock* lock = new CLock( TEXT( \"_tmp_lock_01_\" ) );"}, {"page": 326, "x": 126.0, "y": 453.6, "text": "  ++iValue;"}, {"page": 326, "x": 126.0, "y": 465.8, "text": "  delete lock;"}, {"page": 326, "x": 126.0, "y": 478.1, "text": "}"}, {"page": 326, "x": 126.0, "y": 502.6, "text": "void funcB( void )"}, {"page": 326, "x": 126.0, "y": 514.8, "text": "{"}, {"page": 326, "x": 126.0, "y": 527.0, "text": "  CLock* lock = new CLock( TEXT( \"_tmp_lock_02_\" ));"}, {"page": 326, "x": 126.0, "y": 539.3, "text": "  ++iValue;"}, {"page": 326, "x": 126.0, "y": 551.5, "text": "  delete lock;"}, {"page": 326, "x": 126.0, "y": 563.8, "text": "}"}, {"page": 327, "x": 126.0, "y": 273.4, "text": "template class<T>"}, {"page": 327, "x": 126.0, "y": 285.6, "text": "class CList<T>"}, {"page": 327, "x": 126.0, "y": 297.8, "text": "{"}, {"page": 327, "x": 126.0, "y": 310.1, "text": "public:"}, {"page": 327, "x": 126.0, "y": 322.3, "text": "  CList( ) : next( 0 ), value( 0 ) { }"}, {"page": 327, "x": 126.0, "y": 334.6, "text": "  T Pop( void );"}, {"page": 327, "x": 126.0, "y": 346.8, "text": "private:"}, {"page": 327, "x": 126.0, "y": 359.0, "text": "  CList* next;"}, {"page": 327, "x": 126.0, "y": 371.3, "text": "  T* value;"}, {"page": 327, "x": 126.0, "y": 383.5, "text": "};"}, {"page": 327, "x": 126.0, "y": 408.0, "text": "template class<T>"}, {"page": 327, "x": 126.0, "y": 420.2, "text": "T* CList::Pop( void )"}, {"page": 327, "x": 126.0, "y": 432.5, "text": "{"}, {"page": 327, "x": 126.0, "y": 444.7, "text": "  CList* node = next;"}, {"page": 327, "x": 126.0, "y": 457.0, "text": "  if (node == NULL)"}, {"page": 327, "x": 126.0, "y": 469.2, "text": "  {"}, {"page": 327, "x": 126.0, "y": 481.4, "text": "    return 0;"}, {"page": 327, "x": 126.0, "y": 493.7, "text": "  }"}, {"page": 327, "x": 126.0, "y": 518.2, "text": "  CLock* lock = new CLock(_T(\"_tmp_lock_\"));"}, {"page": 327, "x": 126.0, "y": 530.4, "text": "  next = node->next;"}, {"page": 327, "x": 126.0, "y": 542.6, "text": "  delete lock;"}, {"page": 327, "x": 126.0, "y": 567.1, "text": "  return node->value;"}, {"page": 327, "x": 126.0, "y": 579.4, "text": "}"}, {"page": 328, "x": 126.0, "y": 474.0, "text": "template class<T>"}, {"page": 328, "x": 126.0, "y": 486.2, "text": "class CList<T>"}, {"page": 328, "x": 126.0, "y": 498.5, "text": "{"}, {"page": 328, "x": 126.0, "y": 510.7, "text": "public:"}, {"page": 328, "x": 126.0, "y": 523.0, "text": "  CList( ) : next( 0 ), value( 0 ) { }"}, {"page": 328, "x": 126.0, "y": 535.2, "text": "  T Pop( void );"}, {"page": 328, "x": 126.0, "y": 547.4, "text": "private:"}, {"page": 328, "x": 126.0, "y": 559.7, "text": "  CList* next;"}, {"page": 328, "x": 126.0, "y": 571.9, "text": "  T* value;"}, {"page": 328, "x": 126.0, "y": 584.2, "text": "};"}, {"page": 328, "x": 126.0, "y": 608.6, "text": "template class<T>"}, {"page": 329, "x": 126.0, "y": 115.3, "text": "T* CList::Pop( void )"}, {"page": 329, "x": 126.0, "y": 127.5, "text": "{"}, {"page": 329, "x": 126.0, "y": 139.8, "text": "  CLock* lock = new CLock(_T(\"_tmp_lock_\"));"}, {"page": 329, "x": 126.0, "y": 164.3, "text": "  CList* node = next;"}, {"page": 329, "x": 126.0, "y": 176.5, "text": "  if (node == NULL)"}, {"page": 329, "x": 126.0, "y": 188.7, "text": "  {"}, {"page": 329, "x": 126.0, "y": 201.0, "text": "    return 0;"}, {"page": 329, "x": 126.0, "y": 213.2, "text": "  }"}, {"page": 329, "x": 126.0, "y": 237.7, "text": "  next = node->next;"}, {"page": 329, "x": 126.0, "y": 249.9, "text": "  delete lock;"}, {"page": 329, "x": 126.0, "y": 274.4, "text": "  return node->value;"}, {"page": 329, "x": 126.0, "y": 286.6, "text": "}"}, {"page": 329, "x": 126.0, "y": 500.0, "text": "class CBankAccount"}, {"page": 329, "x": 126.0, "y": 512.2, "text": "{"}, {"page": 329, "x": 126.0, "y": 524.5, "text": "public:"}, {"page": 329, "x": 126.0, "y": 536.7, "text": "  CBankAccount(){ _tcscpy( szLock, LockName( ) ); }"}, {"page": 329, "x": 126.0, "y": 549.0, "text": "  static void Transfer(CBankAccount* a, CBankAccount* b, double"}, {"page": 329, "x": 126.0, "y": 559.8, "text": "dAmount);"}, {"page": 330, "x": 126.0, "y": 115.3, "text": "  static TCHAR* LockName(void);"}, {"page": 330, "x": 126.0, "y": 127.5, "text": "private:"}, {"page": 330, "x": 126.0, "y": 139.8, "text": "  unsigned uID;"}, {"page": 330, "x": 126.0, "y": 152.0, "text": "  double dBalance;"}, {"page": 330, "x": 126.0, "y": 164.3, "text": "  TCHAR szLock[16];"}, {"page": 330, "x": 126.0, "y": 176.5, "text": "};"}, {"page": 330, "x": 126.0, "y": 201.0, "text": "TCHAR* CBankAccount::LockName(void)"}, {"page": 330, "x": 126.0, "y": 213.2, "text": "{"}, {"page": 330, "x": 126.0, "y": 225.5, "text": "  static int iCount = 0;"}, {"page": 330, "x": 126.0, "y": 237.7, "text": "  static TCHAR szBuffer[16];"}, {"page": 330, "x": 126.0, "y": 249.9, "text": "  wsprintf( szBuffer, _T(\"_lock_%d_\"), ++iCount );"}, {"page": 330, "x": 126.0, "y": 262.2, "text": "  return szBuffer;"}, {"page": 330, "x": 126.0, "y": 274.4, "text": "}"}, {"page": 330, "x": 126.0, "y": 298.9, "text": "void CBankAccount::Transfer(CBankAccount* a, CBankAccount* b, double"}, {"page": 330, "x": 126.0, "y": 309.7, "text": "dAmount )"}, {"page": 330, "x": 126.0, "y": 321.9, "text": "{"}, {"page": 330, "x": 126.0, "y": 334.2, "text": "  CLock* outerLock = new CLock(a->szLock);"}, {"page": 330, "x": 126.0, "y": 346.4, "text": "  if (dAmount < a->dBalance)"}, {"page": 330, "x": 126.0, "y": 358.6, "text": "  {"}, {"page": 330, "x": 126.0, "y": 370.9, "text": "    CLock* innerLock = new CLock(b->szLock);"}, {"page": 330, "x": 126.0, "y": 383.1, "text": "    a->dBalance -= dAmount;"}, {"page": 330, "x": 126.0, "y": 395.4, "text": "    b->dBalance += dAmount;"}, {"page": 330, "x": 126.0, "y": 407.6, "text": "    delete innerLock;"}, {"page": 330, "x": 126.0, "y": 419.8, "text": "  }"}, {"page": 330, "x": 126.0, "y": 432.1, "text": "  delete outerLock;"}, {"page": 330, "x": 126.0, "y": 444.3, "text": "}"}, {"page": 332, "x": 126.0, "y": 302.2, "text": "1.\t Create a new C++ Console application named ConcurrentDesign."}, {"page": 332, "x": 126.0, "y": 318.5, "text": "2.\t Open Solution Explorer and open the stdafx.h file. Copy and paste the following"}, {"page": 332, "x": 144.0, "y": 347.4, "text": "#pragma once"}, {"page": 332, "x": 144.0, "y": 371.9, "text": "#include \"targetver.h\""}, {"page": 332, "x": 144.0, "y": 396.4, "text": "#include <stdio.h>"}, {"page": 332, "x": 144.0, "y": 408.6, "text": "#include <tchar.h>"}, {"page": 332, "x": 144.0, "y": 420.9, "text": "#include <Windows.h>"}, {"page": 332, "x": 144.0, "y": 433.1, "text": "#include <cfloat>"}, {"page": 332, "x": 144.0, "y": 445.3, "text": "#include <time.h>"}, {"page": 332, "x": 144.0, "y": 457.6, "text": "#include <omp.h>"}, {"page": 332, "x": 144.0, "y": 482.1, "text": "#include \"Schwefel.h\""}, {"page": 332, "x": 144.0, "y": 512.9, "text": "Schwefel. Open Schwefel.h. Copy and paste the following code to it:"}, {"page": 332, "x": 144.0, "y": 529.8, "text": "#ifndef __SCHWEFEL__"}, {"page": 332, "x": 144.0, "y": 542.1, "text": "#define __SCHWEFEL__"}, {"page": 332, "x": 144.0, "y": 566.5, "text": "#include \"stdafx.h\""}, {"page": 332, "x": 144.0, "y": 591.0, "text": "SYSTEMTIME operator - (const SYSTEMTIME& stFirst, const"}, {"page": 332, "x": 144.0, "y": 601.8, "text": "SYSTEMTIME& stSecond);"}, {"page": 332, "x": 144.0, "y": 626.3, "text": "class CSchwefel"}, {"page": 333, "x": 144.0, "y": 115.3, "text": "{"}, {"page": 333, "x": 144.0, "y": 127.5, "text": "public:"}, {"page": 333, "x": 144.0, "y": 139.8, "text": "  CSchwefel(void) : pdAllele(0) {}"}, {"page": 333, "x": 144.0, "y": 152.0, "text": "  CSchwefel(unsigned uSize) { pdAllele = new double[this->uSize ="}, {"page": 333, "x": 144.0, "y": 162.8, "text": "uSize]; Initialize(); }"}, {"page": 333, "x": 144.0, "y": 175.1, "text": "  double* Allele(void) const { return pdAllele; }"}, {"page": 333, "x": 144.0, "y": 187.3, "text": "  double Allele(unsigned uIndex) const { return pdAllele[uIndex];"}, {"page": 333, "x": 144.0, "y": 198.1, "text": "}"}, {"page": 333, "x": 144.0, "y": 210.3, "text": "  double Allele(double dValue, unsigned uIndex) { return"}, {"page": 333, "x": 144.0, "y": 221.1, "text": "pdAllele[uIndex] = dValue; }"}, {"page": 333, "x": 144.0, "y": 233.4, "text": "  unsigned Size(void) const { return uSize; }"}, {"page": 333, "x": 144.0, "y": 245.6, "text": "  unsigned Size(unsigned uSize) { return this->uSize = uSize; }"}, {"page": 333, "x": 144.0, "y": 257.8, "text": "  virtual ~CSchwefel(void) { if (pdAllele != 0) delete[] pdAllele;"}, {"page": 333, "x": 144.0, "y": 268.6, "text": "}"}, {"page": 333, "x": 144.0, "y": 280.9, "text": "  double& Sum(void) { return dSum; }"}, {"page": 333, "x": 144.0, "y": 293.1, "text": "  double& Min(void) { return dMin; }"}, {"page": 333, "x": 144.0, "y": 305.4, "text": "  double& Score(void) { return dScore; }"}, {"page": 333, "x": 144.0, "y": 317.6, "text": "  double& Best(void) { return dBest; }"}, {"page": 333, "x": 144.0, "y": 329.8, "text": "  virtual double Evaluate(void* lpParameters = 0);"}, {"page": 333, "x": 144.0, "y": 342.1, "text": "  void Initialize();"}, {"page": 333, "x": 144.0, "y": 354.3, "text": "  void Initialize(unsigned uSize);"}, {"page": 333, "x": 144.0, "y": 366.6, "text": "  SYSTEMTIME& StartTime(void) { return stStart; }"}, {"page": 333, "x": 144.0, "y": 378.8, "text": "  SYSTEMTIME& EndTime(void) { return stEnd; }"}, {"page": 333, "x": 144.0, "y": 391.0, "text": "  TCHAR* Elapsed(void);"}, {"page": 333, "x": 144.0, "y": 403.3, "text": "  TCHAR* Elapsed(TCHAR* szElapsed);"}, {"page": 333, "x": 144.0, "y": 415.5, "text": "  static const unsigned ThreadNumber = 4;"}, {"page": 333, "x": 144.0, "y": 427.8, "text": "protected:"}, {"page": 333, "x": 144.0, "y": 440.0, "text": "  CSchwefel(const CSchwefel&) { }"}, {"page": 333, "x": 144.0, "y": 452.2, "text": "  CSchwefel& operator = (const CSchwefel&) { return *this; }"}, {"page": 333, "x": 144.0, "y": 464.5, "text": "  virtual TCHAR* ObjectName(void) const { return _T(\"Schwefel\"); }"}, {"page": 333, "x": 144.0, "y": 476.7, "text": "private:"}, {"page": 333, "x": 144.0, "y": 489.0, "text": "  double* pdAllele;"}, {"page": 333, "x": 144.0, "y": 501.2, "text": "  unsigned uSize;"}, {"page": 333, "x": 144.0, "y": 513.4, "text": "  double dSum;"}, {"page": 333, "x": 144.0, "y": 525.7, "text": "  double dMin;"}, {"page": 333, "x": 144.0, "y": 537.9, "text": "  double dScore;"}, {"page": 333, "x": 144.0, "y": 550.2, "text": "  double dBest;"}, {"page": 333, "x": 144.0, "y": 562.4, "text": "  SYSTEMTIME stStart;"}, {"page": 333, "x": 144.0, "y": 574.7, "text": "  SYSTEMTIME stEnd;"}, {"page": 333, "x": 144.0, "y": 599.1, "text": "  double Random(double dMin, double dMax);"}, {"page": 333, "x": 144.0, "y": 611.4, "text": "  static unsigned Seed(void) { static unsigned uSeed = rand() %"}, {"page": 333, "x": 144.0, "y": 622.2, "text": "time(NULL); return uSeed++; }"}, {"page": 333, "x": 144.0, "y": 634.4, "text": "};"}, {"page": 334, "x": 144.0, "y": 126.8, "text": "Schwefel. Open Schwefel.cpp. Copy and paste the following code to it:"}, {"page": 334, "x": 144.0, "y": 143.8, "text": "#include \"stdafx.h\""}, {"page": 334, "x": 144.0, "y": 165.8, "text": "double CSchwefel::Evaluate(void* lpParameters)"}, {"page": 334, "x": 144.0, "y": 178.1, "text": "{"}, {"page": 334, "x": 144.0, "y": 190.3, "text": "  GetSystemTime(&stStart);"}, {"page": 334, "x": 144.0, "y": 212.4, "text": "  for (unsigned i = 0; i < uSize; i++)"}, {"page": 334, "x": 144.0, "y": 224.6, "text": "  {"}, {"page": 334, "x": 144.0, "y": 236.9, "text": "    dSum += pdAllele[i];"}, {"page": 334, "x": 144.0, "y": 259.0, "text": "    if (dMin > pdAllele[i])"}, {"page": 334, "x": 144.0, "y": 271.2, "text": "    {"}, {"page": 334, "x": 144.0, "y": 283.4, "text": "      dMin = pdAllele[i];"}, {"page": 334, "x": 144.0, "y": 295.7, "text": "    }"}, {"page": 334, "x": 144.0, "y": 320.2, "text": "    double dInnerSum = 0;"}, {"page": 334, "x": 144.0, "y": 342.2, "text": "    for (unsigned j = 0; j < i; j++)"}, {"page": 334, "x": 144.0, "y": 354.5, "text": "    {"}, {"page": 334, "x": 144.0, "y": 366.7, "text": "      dInnerSum += pdAllele[j];"}, {"page": 334, "x": 144.0, "y": 379.0, "text": "    }"}, {"page": 334, "x": 144.0, "y": 401.0, "text": "    double dTmp = dInnerSum * dInnerSum;"}, {"page": 334, "x": 144.0, "y": 413.3, "text": "    dScore += dTmp;"}, {"page": 334, "x": 144.0, "y": 435.4, "text": "    if (i != 0 && dBest > dTmp)"}, {"page": 334, "x": 144.0, "y": 447.6, "text": "    {"}, {"page": 334, "x": 144.0, "y": 459.8, "text": "      dBest = dTmp;"}, {"page": 334, "x": 144.0, "y": 472.1, "text": "    }"}, {"page": 334, "x": 144.0, "y": 484.3, "text": "  }"}, {"page": 334, "x": 144.0, "y": 506.4, "text": "  GetSystemTime(&stEnd);"}, {"page": 334, "x": 144.0, "y": 528.5, "text": "  return dScore;"}, {"page": 334, "x": 144.0, "y": 540.7, "text": "}"}, {"page": 334, "x": 144.0, "y": 562.8, "text": "void CSchwefel::Initialize(void)"}, {"page": 334, "x": 144.0, "y": 575.0, "text": "{"}, {"page": 334, "x": 144.0, "y": 587.3, "text": "  srand(Seed());"}, {"page": 334, "x": 144.0, "y": 609.4, "text": "  dSum = 0;"}, {"page": 334, "x": 144.0, "y": 621.6, "text": "  dMin = DBL_MAX;"}, {"page": 334, "x": 144.0, "y": 633.8, "text": "  dScore = 0;"}, {"page": 335, "x": 144.0, "y": 115.3, "text": "  dBest = DBL_MAX;"}, {"page": 335, "x": 144.0, "y": 127.5, "text": "  stStart = { 0 };"}, {"page": 335, "x": 144.0, "y": 139.8, "text": "  stEnd = { 0 };"}, {"page": 335, "x": 144.0, "y": 161.8, "text": "  for (unsigned uIndex = 0; uIndex < uSize; uIndex++)"}, {"page": 335, "x": 144.0, "y": 174.1, "text": "  {"}, {"page": 335, "x": 144.0, "y": 186.3, "text": "    pdAllele[uIndex] = Random(-65.536, 65.536);"}, {"page": 335, "x": 144.0, "y": 208.4, "text": "    dSum += pdAllele[uIndex];"}, {"page": 335, "x": 144.0, "y": 230.5, "text": "    if (dMin > pdAllele[uIndex])"}, {"page": 335, "x": 144.0, "y": 242.7, "text": "    {"}, {"page": 335, "x": 144.0, "y": 255.0, "text": "      dMin = pdAllele[uIndex];"}, {"page": 335, "x": 144.0, "y": 267.2, "text": "    }"}, {"page": 335, "x": 144.0, "y": 279.4, "text": "  }"}, {"page": 335, "x": 144.0, "y": 291.7, "text": "}"}, {"page": 335, "x": 144.0, "y": 313.8, "text": "void CSchwefel::Initialize(unsigned uSize)"}, {"page": 335, "x": 144.0, "y": 326.0, "text": "{"}, {"page": 335, "x": 144.0, "y": 338.2, "text": "  if (pdAllele == NULL)"}, {"page": 335, "x": 144.0, "y": 350.5, "text": "  {"}, {"page": 335, "x": 144.0, "y": 362.7, "text": "    pdAllele = new double[this->uSize = uSize];"}, {"page": 335, "x": 144.0, "y": 375.0, "text": "  }"}, {"page": 335, "x": 144.0, "y": 397.0, "text": "  srand(Seed());"}, {"page": 335, "x": 144.0, "y": 419.1, "text": "  dSum = 0;"}, {"page": 335, "x": 144.0, "y": 431.4, "text": "  dMin = DBL_MAX;"}, {"page": 335, "x": 144.0, "y": 443.6, "text": "  dScore = 0;"}, {"page": 335, "x": 144.0, "y": 455.8, "text": "  dBest = DBL_MAX;"}, {"page": 335, "x": 144.0, "y": 468.1, "text": "  stStart = { 0 };"}, {"page": 335, "x": 144.0, "y": 480.3, "text": "  stEnd = { 0 };"}, {"page": 335, "x": 144.0, "y": 502.4, "text": "  for (unsigned uIndex = 0; uIndex < uSize; uIndex++)"}, {"page": 335, "x": 144.0, "y": 514.7, "text": "  {"}, {"page": 335, "x": 144.0, "y": 526.9, "text": "    pdAllele[uIndex] = Random(-65.536, 65.536);"}, {"page": 335, "x": 144.0, "y": 549.0, "text": "    dSum += pdAllele[uIndex];"}, {"page": 335, "x": 144.0, "y": 571.0, "text": "    if (dMin > pdAllele[uIndex])"}, {"page": 335, "x": 144.0, "y": 583.3, "text": "    {"}, {"page": 335, "x": 144.0, "y": 595.5, "text": "      dMin = pdAllele[uIndex];"}, {"page": 335, "x": 144.0, "y": 607.8, "text": "    }"}, {"page": 335, "x": 144.0, "y": 620.0, "text": "  }"}, {"page": 336, "x": 144.0, "y": 115.3, "text": "}"}, {"page": 336, "x": 144.0, "y": 137.4, "text": "TCHAR* CSchwefel::Elapsed(void)"}, {"page": 336, "x": 144.0, "y": 149.6, "text": "{"}, {"page": 336, "x": 144.0, "y": 161.8, "text": "  static TCHAR szBuffer[1024];"}, {"page": 336, "x": 144.0, "y": 183.9, "text": "  SYSTEMTIME stTime = stEnd - stStart;"}, {"page": 336, "x": 144.0, "y": 206.0, "text": "  swprintf(szBuffer, 1024, _T(\"%ws:\\nAllele size:\\t%u\\nSum:\\t\\"}, {"page": 336, "x": 144.0, "y": 216.8, "text": "t%lf\\nMin:\\t\\t%lf\\nScore:\\t\\t%lf\\nBest:\\t\\t%lf\\nExecution time:"}, {"page": 336, "x": 144.0, "y": 227.6, "text": "%02u:%02u:%02u:%03u\\n\\n\"),"}, {"page": 336, "x": 144.0, "y": 239.8, "text": "    ObjectName(), uSize, dSum, dMin, dScore, dBest, stTime.wHour,"}, {"page": 336, "x": 144.0, "y": 250.6, "text": "stTime.wMinute, stTime.wSecond, stTime.wMilliseconds);"}, {"page": 336, "x": 144.0, "y": 262.9, "text": "  return szBuffer;"}, {"page": 336, "x": 144.0, "y": 275.1, "text": "}"}, {"page": 336, "x": 144.0, "y": 297.2, "text": "TCHAR* CSchwefel::Elapsed(TCHAR* szElapsed)"}, {"page": 336, "x": 144.0, "y": 309.4, "text": "{"}, {"page": 336, "x": 144.0, "y": 321.7, "text": "  if (szElapsed == NULL || _tcslen(szElapsed) < 1024)"}, {"page": 336, "x": 144.0, "y": 333.9, "text": "  {"}, {"page": 336, "x": 144.0, "y": 346.2, "text": "    return _T(\"Error!\\nBuffer too small.\");"}, {"page": 336, "x": 144.0, "y": 358.4, "text": "  }"}, {"page": 336, "x": 144.0, "y": 380.5, "text": "  SYSTEMTIME stTime = stEnd - stStart;"}, {"page": 336, "x": 144.0, "y": 402.6, "text": "  swprintf(szElapsed, 1024, _T(\"%ws:\\nAllele size:\\t%u\\nSum:\\t\\"}, {"page": 336, "x": 144.0, "y": 413.4, "text": "t%lf\\nMin:\\t\\t%lf\\nScore:\\t\\t%lf\\nBest:\\t\\t%lf\\nExecution time:"}, {"page": 336, "x": 144.0, "y": 424.2, "text": "%02u:%02u:%02u:%03u\\n\\n\"),"}, {"page": 336, "x": 144.0, "y": 436.4, "text": "    ObjectName(), uSize, dSum, dMin, dScore, dBest, stTime.wHour,"}, {"page": 336, "x": 144.0, "y": 447.2, "text": "stTime.wMinute, stTime.wSecond, stTime.wMilliseconds);"}, {"page": 336, "x": 144.0, "y": 459.4, "text": "  return szElapsed;"}, {"page": 336, "x": 144.0, "y": 471.7, "text": "}"}, {"page": 336, "x": 144.0, "y": 493.8, "text": "double CSchwefel::Random(double dMin, double dMax)"}, {"page": 336, "x": 144.0, "y": 506.0, "text": "{"}, {"page": 336, "x": 144.0, "y": 518.2, "text": "  double dValue = (double)rand() / RAND_MAX;"}, {"page": 336, "x": 144.0, "y": 530.5, "text": "  return dMin + dValue * (dMax - dMin);"}, {"page": 336, "x": 144.0, "y": 542.7, "text": "}"}, {"page": 336, "x": 144.0, "y": 564.8, "text": "SYSTEMTIME operator - (const SYSTEMTIME& stFirst, const"}, {"page": 336, "x": 144.0, "y": 575.6, "text": "SYSTEMTIME& stSecond)"}, {"page": 336, "x": 144.0, "y": 587.8, "text": "{"}, {"page": 336, "x": 144.0, "y": 600.1, "text": "  SYSTEMTIME stResult;"}, {"page": 336, "x": 144.0, "y": 612.3, "text": "  FILETIME ftTime;"}, {"page": 337, "x": 144.0, "y": 115.3, "text": "  ULARGE_INTEGER uLargeInteger;"}, {"page": 337, "x": 144.0, "y": 137.4, "text": "  __int64 i64Right;"}, {"page": 337, "x": 144.0, "y": 149.6, "text": "  __int64 i64Left;"}, {"page": 337, "x": 144.0, "y": 161.8, "text": "  __int64 i64Result;"}, {"page": 337, "x": 144.0, "y": 183.9, "text": "  SystemTimeToFileTime(&stFirst, &ftTime);"}, {"page": 337, "x": 144.0, "y": 196.2, "text": "  uLargeInteger.LowPart = ftTime.dwLowDateTime;"}, {"page": 337, "x": 144.0, "y": 208.4, "text": "  uLargeInteger.HighPart = ftTime.dwHighDateTime;"}, {"page": 337, "x": 144.0, "y": 220.6, "text": "  i64Right = uLargeInteger.QuadPart;"}, {"page": 337, "x": 144.0, "y": 242.7, "text": "  SystemTimeToFileTime(&stSecond, &ftTime);"}, {"page": 337, "x": 144.0, "y": 255.0, "text": "  uLargeInteger.LowPart = ftTime.dwLowDateTime;"}, {"page": 337, "x": 144.0, "y": 267.2, "text": "  uLargeInteger.HighPart = ftTime.dwHighDateTime;"}, {"page": 337, "x": 144.0, "y": 279.4, "text": "  i64Left = uLargeInteger.QuadPart;"}, {"page": 337, "x": 144.0, "y": 301.5, "text": "  i64Result = i64Right - i64Left;"}, {"page": 337, "x": 144.0, "y": 323.6, "text": "  uLargeInteger.QuadPart = i64Result;"}, {"page": 337, "x": 144.0, "y": 335.8, "text": "  ftTime.dwLowDateTime = uLargeInteger.LowPart;"}, {"page": 337, "x": 144.0, "y": 348.1, "text": "  ftTime.dwHighDateTime = uLargeInteger.HighPart;"}, {"page": 337, "x": 144.0, "y": 360.3, "text": "  FileTimeToSystemTime(&ftTime, &stResult);"}, {"page": 337, "x": 144.0, "y": 382.4, "text": "  return stResult;"}, {"page": 337, "x": 144.0, "y": 394.6, "text": "}"}, {"page": 337, "x": 126.0, "y": 413.5, "text": "5.\t Open Solution Explorer and open ConcurrentDesign.cpp. Copy and paste the"}, {"page": 337, "x": 144.0, "y": 442.4, "text": "#include \"stdafx.h\""}, {"page": 337, "x": 144.0, "y": 466.9, "text": "int _tmain(int argc, _TCHAR* argv[])"}, {"page": 337, "x": 144.0, "y": 479.1, "text": "{"}, {"page": 337, "x": 144.0, "y": 491.4, "text": "  CSchwefel Schwefel(100000);"}, {"page": 337, "x": 144.0, "y": 503.6, "text": "  Schwefel.Evaluate();"}, {"page": 337, "x": 144.0, "y": 528.1, "text": "  _tprintf_s(Schwefel.Elapsed());"}, {"page": 337, "x": 144.0, "y": 552.6, "text": "#ifdef _DEBUG"}, {"page": 337, "x": 144.0, "y": 564.8, "text": "  return system(\"pause\");"}, {"page": 337, "x": 144.0, "y": 577.0, "text": "#endif"}, {"page": 337, "x": 144.0, "y": 601.5, "text": "  return 0;"}, {"page": 337, "x": 144.0, "y": 613.8, "text": "}"}, {"page": 340, "x": 126.0, "y": 229.6, "text": "1.\t Open Solution Explorer and open the file stdafx.h. Copy and paste the following"}, {"page": 340, "x": 144.0, "y": 258.6, "text": "#pragma once"}, {"page": 340, "x": 144.0, "y": 283.0, "text": "#include \"targetver.h\""}, {"page": 340, "x": 144.0, "y": 307.5, "text": "#include <stdio.h>"}, {"page": 340, "x": 144.0, "y": 319.8, "text": "#include <tchar.h>"}, {"page": 340, "x": 144.0, "y": 332.0, "text": "#include <Windows.h>"}, {"page": 340, "x": 144.0, "y": 344.2, "text": "#include <cfloat>"}, {"page": 340, "x": 144.0, "y": 356.5, "text": "#include <time.h>"}, {"page": 340, "x": 144.0, "y": 368.7, "text": "#include <omp.h>"}, {"page": 340, "x": 144.0, "y": 393.2, "text": "#include \"Schwefel.h\""}, {"page": 340, "x": 144.0, "y": 405.4, "text": "#include \"SchwefelMT.h\""}, {"page": 340, "x": 144.0, "y": 436.2, "text": "SchwefelMT. Open SchwefelMT.h. Copy and paste the following code to it:"}, {"page": 340, "x": 144.0, "y": 453.2, "text": "#ifndef __SCHWEFELMT__"}, {"page": 340, "x": 144.0, "y": 465.4, "text": "#define __SCHWEFELMT__"}, {"page": 340, "x": 144.0, "y": 489.9, "text": "#include \"stdafx.h\""}, {"page": 340, "x": 144.0, "y": 514.4, "text": "class CSchwefelMT : public CSchwefel"}, {"page": 340, "x": 144.0, "y": 526.6, "text": "{"}, {"page": 340, "x": 144.0, "y": 538.9, "text": "public:"}, {"page": 340, "x": 144.0, "y": 551.1, "text": "  CSchwefelMT() : CSchwefel() { }"}, {"page": 340, "x": 144.0, "y": 563.4, "text": "  CSchwefelMT(unsigned uSize) : CSchwefel(uSize) { }"}, {"page": 340, "x": 144.0, "y": 575.6, "text": "  virtual ~CSchwefelMT(void) { }"}, {"page": 340, "x": 144.0, "y": 587.8, "text": "  virtual double Evaluate(void* lpParameters = 0);"}, {"page": 340, "x": 144.0, "y": 600.1, "text": "protected:"}, {"page": 340, "x": 144.0, "y": 612.3, "text": "  CSchwefelMT(const CSchwefel&) { }"}, {"page": 340, "x": 144.0, "y": 624.6, "text": "  CSchwefelMT& operator = (const CSchwefel&) { return *this; }"}, {"page": 341, "x": 144.0, "y": 115.3, "text": "  virtual TCHAR* ObjectName(void) const { return _T(\"SchwefelMT\");"}, {"page": 341, "x": 144.0, "y": 126.1, "text": "}"}, {"page": 341, "x": 144.0, "y": 138.3, "text": "private:"}, {"page": 341, "x": 144.0, "y": 150.6, "text": "  static DWORD WINAPI StartAddress(LPVOID lpParameter);"}, {"page": 341, "x": 144.0, "y": 162.8, "text": "  struct ThreadParams"}, {"page": 341, "x": 144.0, "y": 175.1, "text": "  {"}, {"page": 341, "x": 144.0, "y": 187.3, "text": "    CSchwefelMT* this_ptr;"}, {"page": 341, "x": 144.0, "y": 199.5, "text": "    unsigned uThreadIndex;"}, {"page": 341, "x": 144.0, "y": 211.8, "text": "  };"}, {"page": 341, "x": 144.0, "y": 224.0, "text": "};"}, {"page": 341, "x": 144.0, "y": 248.5, "text": "#endif"}, {"page": 341, "x": 144.0, "y": 279.3, "text": "SchwefelMT. Open SchwefelMT.cpp. Copy and paste the following code to it:"}, {"page": 341, "x": 144.0, "y": 296.2, "text": "#include \"stdafx.h\""}, {"page": 341, "x": 144.0, "y": 320.7, "text": "DWORD WINAPI CSchwefelMT::StartAddress(LPVOID lpParameter)"}, {"page": 341, "x": 144.0, "y": 333.0, "text": "{"}, {"page": 341, "x": 144.0, "y": 345.2, "text": "  ThreadParams* params = (ThreadParams*)lpParameter;"}, {"page": 341, "x": 144.0, "y": 369.7, "text": "  unsigned uChunk = ((unsigned)params->this_ptr->Size()) /"}, {"page": 341, "x": 144.0, "y": 380.5, "text": "ThreadNumber;"}, {"page": 341, "x": 144.0, "y": 392.7, "text": "  unsigned uMax = (params->uThreadIndex + 1) * uChunk;"}, {"page": 341, "x": 144.0, "y": 417.2, "text": "  for (unsigned i = params->uThreadIndex * uChunk; i < uMax; i++)"}, {"page": 341, "x": 144.0, "y": 429.4, "text": "  {"}, {"page": 341, "x": 144.0, "y": 441.7, "text": "    params->this_ptr->Sum() += params->this_ptr->Allele(i);"}, {"page": 341, "x": 144.0, "y": 466.2, "text": "    if (params->this_ptr->Min() > params->this_ptr->Allele(i))"}, {"page": 341, "x": 144.0, "y": 478.4, "text": "    {"}, {"page": 341, "x": 144.0, "y": 490.6, "text": "      params->this_ptr->Min() = params->this_ptr->Allele(i);"}, {"page": 341, "x": 144.0, "y": 502.9, "text": "    }"}, {"page": 341, "x": 144.0, "y": 527.4, "text": "    double dInnerSum = 0;"}, {"page": 341, "x": 144.0, "y": 551.8, "text": "    for (unsigned j = 0; j < i; j++)"}, {"page": 341, "x": 144.0, "y": 564.1, "text": "    {"}, {"page": 341, "x": 144.0, "y": 576.3, "text": "      dInnerSum += params->this_ptr->Allele(j);"}, {"page": 341, "x": 144.0, "y": 588.6, "text": "    }"}, {"page": 341, "x": 144.0, "y": 613.0, "text": "    double dTmp = dInnerSum * dInnerSum;"}, {"page": 342, "x": 144.0, "y": 115.3, "text": "    params->this_ptr->Score() += dTmp;"}, {"page": 342, "x": 144.0, "y": 139.8, "text": "    if (i != 0 && params->this_ptr->Best() > dTmp)"}, {"page": 342, "x": 144.0, "y": 152.0, "text": "    {"}, {"page": 342, "x": 144.0, "y": 164.3, "text": "      params->this_ptr->Best() = dTmp;"}, {"page": 342, "x": 144.0, "y": 176.5, "text": "    }"}, {"page": 342, "x": 144.0, "y": 188.7, "text": "  }"}, {"page": 342, "x": 144.0, "y": 213.2, "text": "  return 0L;"}, {"page": 342, "x": 144.0, "y": 225.5, "text": "}"}, {"page": 342, "x": 144.0, "y": 249.9, "text": "double CSchwefelMT::Evaluate(void* lpParameters)"}, {"page": 342, "x": 144.0, "y": 262.2, "text": "{"}, {"page": 342, "x": 144.0, "y": 274.4, "text": "  HANDLE hThreads[ThreadNumber];"}, {"page": 342, "x": 144.0, "y": 286.6, "text": "  ThreadParams params[ThreadNumber];"}, {"page": 342, "x": 144.0, "y": 311.1, "text": "  GetSystemTime(&StartTime());"}, {"page": 342, "x": 144.0, "y": 335.6, "text": "  for (unsigned uIndex = 0; uIndex < ThreadNumber; uIndex++)"}, {"page": 342, "x": 144.0, "y": 347.8, "text": "  {"}, {"page": 342, "x": 144.0, "y": 360.1, "text": "    params[uIndex] = { this, uIndex };"}, {"page": 342, "x": 144.0, "y": 372.3, "text": "    hThreads[uIndex] = CreateThread(NULL, 0, (LPTHREAD_START_"}, {"page": 342, "x": 144.0, "y": 383.1, "text": "ROUTINE)StartAddress, &params[uIndex], 0, NULL);"}, {"page": 342, "x": 144.0, "y": 395.4, "text": "  }"}, {"page": 342, "x": 144.0, "y": 419.8, "text": "  WaitForMultipleObjects(ThreadNumber, hThreads, TRUE, INFINITE);"}, {"page": 342, "x": 144.0, "y": 444.3, "text": "  GetSystemTime(&EndTime());"}, {"page": 342, "x": 144.0, "y": 468.8, "text": "  for (unsigned uIndex = 0; uIndex < ThreadNumber; uIndex++)"}, {"page": 342, "x": 144.0, "y": 481.0, "text": "  {"}, {"page": 342, "x": 144.0, "y": 493.3, "text": "    CloseHandle(hThreads[uIndex]);"}, {"page": 342, "x": 144.0, "y": 505.5, "text": "  }"}, {"page": 342, "x": 144.0, "y": 530.0, "text": "  return Score();"}, {"page": 342, "x": 144.0, "y": 542.2, "text": "}"}, {"page": 342, "x": 126.0, "y": 561.1, "text": "4.\t Open Solution Explorer and open the ConcurrentDesign.cpp file. Copy and paste"}, {"page": 342, "x": 144.0, "y": 590.0, "text": "#include \"stdafx.h\""}, {"page": 342, "x": 144.0, "y": 614.5, "text": "int _tmain(int argc, _TCHAR* argv[])"}, {"page": 343, "x": 144.0, "y": 115.3, "text": "{"}, {"page": 343, "x": 144.0, "y": 127.5, "text": "  CSchwefel Schwefel(100000);"}, {"page": 343, "x": 144.0, "y": 139.8, "text": "  Schwefel.Evaluate();"}, {"page": 343, "x": 144.0, "y": 164.3, "text": "  _tprintf_s(Schwefel.Elapsed());"}, {"page": 343, "x": 144.0, "y": 188.7, "text": "  CSchwefelMT SchwefelMT(100000);"}, {"page": 343, "x": 144.0, "y": 201.0, "text": "  SchwefelMT.Evaluate();"}, {"page": 343, "x": 144.0, "y": 225.5, "text": "  _tprintf_s(SchwefelMT.Elapsed());"}, {"page": 343, "x": 144.0, "y": 249.9, "text": "#ifdef _DEBUG"}, {"page": 343, "x": 144.0, "y": 262.2, "text": "  return system(\"pause\");"}, {"page": 343, "x": 144.0, "y": 274.4, "text": "#endif"}, {"page": 343, "x": 144.0, "y": 298.9, "text": "  return 0;"}, {"page": 343, "x": 144.0, "y": 311.1, "text": "}"}, {"page": 343, "x": 126.0, "y": 556.7, "text": "params->this_ptr->Sum() += params->this_ptr->Allele(i);"}, {"page": 344, "x": 126.0, "y": 503.1, "text": "DWORD WINAPI CSchwefelMT::StartAddress(LPVOID lpParameter)"}, {"page": 344, "x": 126.0, "y": 515.3, "text": "{"}, {"page": 344, "x": 126.0, "y": 527.6, "text": "ThreadParams* params = (ThreadParams*)lpParameter;"}, {"page": 344, "x": 126.0, "y": 552.0, "text": "unsigned uChunk = ((unsigned)params->this_ptr->Size()) / ThreadNumber;"}, {"page": 344, "x": 126.0, "y": 564.3, "text": "unsigned uMax = (params->uThreadIndex + 1) * uChunk;"}, {"page": 344, "x": 126.0, "y": 588.8, "text": "double dSum = 0;"}, {"page": 344, "x": 126.0, "y": 601.0, "text": "double dMin = DBL_MAX;"}, {"page": 345, "x": 126.0, "y": 115.3, "text": "double dScore = 0;"}, {"page": 345, "x": 126.0, "y": 127.5, "text": "double dBest = DBL_MAX;"}, {"page": 345, "x": 126.0, "y": 152.0, "text": "HANDLE hMutex = CreateMutex(NULL, FALSE, _T(\"__tmp_mutex__\"));"}, {"page": 345, "x": 126.0, "y": 164.3, "text": "WaitForSingleObject(hMutex, INFINITE);"}, {"page": 345, "x": 126.0, "y": 188.7, "text": "dSum = params->this_ptr->Sum();"}, {"page": 345, "x": 126.0, "y": 201.0, "text": "dMin = params->this_ptr->Min();"}, {"page": 345, "x": 126.0, "y": 213.2, "text": "dScore = params->this_ptr->Score();"}, {"page": 345, "x": 126.0, "y": 225.5, "text": "dBest = params->this_ptr->Best();"}, {"page": 345, "x": 126.0, "y": 249.9, "text": "ReleaseMutex(hMutex);"}, {"page": 345, "x": 126.0, "y": 262.2, "text": "CloseHandle(hMutex);"}, {"page": 345, "x": 126.0, "y": 286.6, "text": "for (unsigned i = params->uThreadIndex * uChunk;i < uMax; i++)"}, {"page": 345, "x": 126.0, "y": 298.9, "text": "{"}, {"page": 345, "x": 126.0, "y": 311.1, "text": "  dSum += params->this_ptr->Allele(i);"}, {"page": 345, "x": 126.0, "y": 335.6, "text": "  if (dMin > params->this_ptr->Allele(i))"}, {"page": 345, "x": 126.0, "y": 347.8, "text": "  {"}, {"page": 345, "x": 126.0, "y": 360.1, "text": "    dMin = params->this_ptr->Allele(i);"}, {"page": 345, "x": 126.0, "y": 372.3, "text": "  }"}, {"page": 345, "x": 126.0, "y": 396.8, "text": "  double dInnerSum = 0;"}, {"page": 345, "x": 126.0, "y": 409.0, "text": "  for (unsigned j = 0; j < i; j++)"}, {"page": 345, "x": 126.0, "y": 421.3, "text": "  {"}, {"page": 345, "x": 126.0, "y": 433.5, "text": "    dInnerSum += params->this_ptr->Allele(j);"}, {"page": 345, "x": 126.0, "y": 445.8, "text": "  }"}, {"page": 345, "x": 126.0, "y": 458.0, "text": "  double dTmp = dInnerSum * dInnerSum;"}, {"page": 345, "x": 126.0, "y": 470.2, "text": "  dScore += dTmp;"}, {"page": 345, "x": 126.0, "y": 494.7, "text": "  if (i != 0 && dBest > dTmp)"}, {"page": 345, "x": 126.0, "y": 507.0, "text": "  {"}, {"page": 345, "x": 126.0, "y": 519.2, "text": "    dBest = dTmp;"}, {"page": 345, "x": 126.0, "y": 531.4, "text": "  }"}, {"page": 345, "x": 126.0, "y": 543.7, "text": "}"}, {"page": 345, "x": 126.0, "y": 568.2, "text": "hMutex = CreateMutex(NULL, FALSE, _T(\"__tmp_mutex__\"));"}, {"page": 345, "x": 126.0, "y": 580.4, "text": "WaitForSingleObject(hMutex, INFINITE);"}, {"page": 345, "x": 126.0, "y": 604.9, "text": "params->this_ptr->Sum() = dSum;"}, {"page": 345, "x": 126.0, "y": 617.1, "text": "if (dMin < params->this_ptr->Min())"}, {"page": 346, "x": 126.0, "y": 115.3, "text": "{"}, {"page": 346, "x": 126.0, "y": 127.5, "text": "  params->this_ptr->Min() = dMin;"}, {"page": 346, "x": 126.0, "y": 139.8, "text": "}"}, {"page": 346, "x": 126.0, "y": 152.0, "text": "params->this_ptr->Score() = dScore;"}, {"page": 346, "x": 126.0, "y": 164.3, "text": "if (dBest < params->this_ptr->Best())"}, {"page": 346, "x": 126.0, "y": 176.5, "text": "{"}, {"page": 346, "x": 126.0, "y": 188.7, "text": "  params->this_ptr->Best() = dBest;"}, {"page": 346, "x": 126.0, "y": 201.0, "text": "}"}, {"page": 346, "x": 126.0, "y": 225.5, "text": "ReleaseMutex(hMutex);"}, {"page": 346, "x": 126.0, "y": 237.7, "text": "CloseHandle(hMutex);"}, {"page": 346, "x": 126.0, "y": 262.2, "text": "return 0L;"}, {"page": 346, "x": 126.0, "y": 274.4, "text": "}"}, {"page": 348, "x": 126.0, "y": 511.3, "text": "1.\t Open the solution ConcurrentDesign."}, {"page": 348, "x": 144.0, "y": 539.6, "text": "CSchwefelP. Open CSchwefelP.h."}, {"page": 348, "x": 144.0, "y": 572.9, "text": "#ifndef __SCHWEFELP__"}, {"page": 348, "x": 144.0, "y": 585.1, "text": "#define __SCHWEFELP__"}, {"page": 348, "x": 144.0, "y": 609.6, "text": "#include \"stdafx.h\""}, {"page": 348, "x": 144.0, "y": 634.1, "text": "class CSchwefelP : public CSchwefel"}, {"page": 349, "x": 144.0, "y": 115.3, "text": "{"}, {"page": 349, "x": 144.0, "y": 127.5, "text": "public:"}, {"page": 349, "x": 144.0, "y": 139.8, "text": "  CSchwefelP() : CSchwefel() { }"}, {"page": 349, "x": 144.0, "y": 152.0, "text": "  CSchwefelP(unsigned uSize) : CSchwefel(uSize) { }"}, {"page": 349, "x": 144.0, "y": 164.3, "text": "  virtual ~CSchwefelP(void) { }"}, {"page": 349, "x": 144.0, "y": 176.5, "text": "  virtual double Evaluate(void* lpParameters = 0);"}, {"page": 349, "x": 144.0, "y": 188.7, "text": "protected:"}, {"page": 349, "x": 144.0, "y": 201.0, "text": "  CSchwefelP(const CSchwefel&) { }"}, {"page": 349, "x": 144.0, "y": 213.2, "text": "  CSchwefelP& operator = (const CSchwefel&) { return *this; }"}, {"page": 349, "x": 144.0, "y": 225.5, "text": "  virtual TCHAR* ObjectName(void) const { return _T(\"SchwefelP\");"}, {"page": 349, "x": 144.0, "y": 236.3, "text": "}"}, {"page": 349, "x": 144.0, "y": 248.5, "text": "private:"}, {"page": 349, "x": 144.0, "y": 260.7, "text": "  //"}, {"page": 349, "x": 144.0, "y": 273.0, "text": "};"}, {"page": 349, "x": 144.0, "y": 297.4, "text": "#endif"}, {"page": 349, "x": 144.0, "y": 328.3, "text": "CSchwefelP. Open CSchwefelP.cpp."}, {"page": 349, "x": 144.0, "y": 361.5, "text": "#include \"stdafx.h\""}, {"page": 349, "x": 144.0, "y": 386.0, "text": "double CSchwefelP::Evaluate(void* lpParameters)"}, {"page": 349, "x": 144.0, "y": 398.2, "text": "{"}, {"page": 349, "x": 144.0, "y": 410.5, "text": "  GetSystemTime(&StartTime());"}, {"page": 349, "x": 144.0, "y": 435.0, "text": "  double sum = 0;"}, {"page": 349, "x": 144.0, "y": 447.2, "text": "  double score = 0;"}, {"page": 349, "x": 144.0, "y": 459.4, "text": "  double min = DBL_MAX;"}, {"page": 349, "x": 144.0, "y": 471.7, "text": "  double best = DBL_MAX;"}, {"page": 349, "x": 144.0, "y": 483.9, "text": "  int iSize = (int)Size();"}, {"page": 349, "x": 144.0, "y": 508.4, "text": "#pragma omp parallel firstprivate(min) firstprivate(best)"}, {"page": 349, "x": 144.0, "y": 520.7, "text": "  {"}, {"page": 349, "x": 144.0, "y": 532.9, "text": "#pragma omp for reduction(+: sum) reduction(+: score) nowait"}, {"page": 349, "x": 144.0, "y": 545.1, "text": "    for (int i = 0; i < iSize; i++)"}, {"page": 349, "x": 144.0, "y": 557.4, "text": "    {"}, {"page": 349, "x": 144.0, "y": 569.6, "text": "      sum += Allele(i);"}, {"page": 349, "x": 144.0, "y": 594.1, "text": "      if (min > Allele(i))"}, {"page": 349, "x": 144.0, "y": 606.3, "text": "      {"}, {"page": 349, "x": 144.0, "y": 618.6, "text": "        min = Allele(i);"}, {"page": 350, "x": 144.0, "y": 115.3, "text": "      }"}, {"page": 350, "x": 144.0, "y": 139.8, "text": "      double dInnerSum = 0;"}, {"page": 350, "x": 144.0, "y": 164.3, "text": "      for (int j = 0; j < i; j++)"}, {"page": 350, "x": 144.0, "y": 176.5, "text": "      {"}, {"page": 350, "x": 144.0, "y": 188.7, "text": "        dInnerSum += Allele(j);"}, {"page": 350, "x": 144.0, "y": 201.0, "text": "      }"}, {"page": 350, "x": 144.0, "y": 225.5, "text": "      double dTmp = dInnerSum * dInnerSum;"}, {"page": 350, "x": 144.0, "y": 237.7, "text": "      score += dTmp;"}, {"page": 350, "x": 144.0, "y": 262.2, "text": "      if (i != 0 && best > dTmp)"}, {"page": 350, "x": 144.0, "y": 274.4, "text": "      {"}, {"page": 350, "x": 144.0, "y": 286.6, "text": "        best = dTmp;"}, {"page": 350, "x": 144.0, "y": 298.9, "text": "      }"}, {"page": 350, "x": 144.0, "y": 311.1, "text": "    }"}, {"page": 350, "x": 144.0, "y": 335.6, "text": "#pragma omp critical"}, {"page": 350, "x": 144.0, "y": 347.8, "text": "    {"}, {"page": 350, "x": 144.0, "y": 360.1, "text": "      if (Best() > best)"}, {"page": 350, "x": 144.0, "y": 372.3, "text": "      {"}, {"page": 350, "x": 144.0, "y": 384.6, "text": "        Best() = best;"}, {"page": 350, "x": 144.0, "y": 396.8, "text": "      }"}, {"page": 350, "x": 144.0, "y": 409.0, "text": "      if (Min() > min)"}, {"page": 350, "x": 144.0, "y": 421.3, "text": "      {"}, {"page": 350, "x": 144.0, "y": 433.5, "text": "        Min() = min;"}, {"page": 350, "x": 144.0, "y": 445.8, "text": "      }"}, {"page": 350, "x": 144.0, "y": 458.0, "text": "    }"}, {"page": 350, "x": 144.0, "y": 470.2, "text": "  }"}, {"page": 350, "x": 144.0, "y": 494.7, "text": "  Sum() = sum;"}, {"page": 350, "x": 144.0, "y": 507.0, "text": "  Score() = score;"}, {"page": 350, "x": 144.0, "y": 531.4, "text": "  GetSystemTime(&EndTime());"}, {"page": 350, "x": 144.0, "y": 555.9, "text": "  return Score();"}, {"page": 350, "x": 144.0, "y": 568.2, "text": "}"}, {"page": 350, "x": 126.0, "y": 587.0, "text": "6.\t Open Solution Explorer and double-click on stdafx.h."}, {"page": 351, "x": 144.0, "y": 131.8, "text": "#pragma once"}, {"page": 351, "x": 144.0, "y": 156.2, "text": "#include \"targetver.h\""}, {"page": 351, "x": 144.0, "y": 180.7, "text": "#include <stdio.h>"}, {"page": 351, "x": 144.0, "y": 193.0, "text": "#include <tchar.h>"}, {"page": 351, "x": 144.0, "y": 205.2, "text": "#include <Windows.h>"}, {"page": 351, "x": 144.0, "y": 217.4, "text": "#include <cfloat>"}, {"page": 351, "x": 144.0, "y": 229.7, "text": "#include <time.h>"}, {"page": 351, "x": 144.0, "y": 241.9, "text": "#include <omp.h>"}, {"page": 351, "x": 144.0, "y": 266.4, "text": "#include \"Schwefel.h\""}, {"page": 351, "x": 144.0, "y": 278.6, "text": "#include \"SchwefelMT.h\""}, {"page": 351, "x": 144.0, "y": 290.9, "text": "#include \"SchwefelP.h\""}, {"page": 351, "x": 126.0, "y": 309.7, "text": "8.\t Open Solution Explorer and double-click on ConcurrentDesign.cpp."}, {"page": 351, "x": 126.0, "y": 326.0, "text": "9.\t Add the following code to ConcurrentDesign.cpp:"}, {"page": 351, "x": 144.0, "y": 343.0, "text": "#include \"stdafx.h\""}, {"page": 351, "x": 144.0, "y": 367.4, "text": "int _tmain(int argc, _TCHAR* argv[])"}, {"page": 351, "x": 144.0, "y": 379.7, "text": "{"}, {"page": 351, "x": 144.0, "y": 391.9, "text": "  CSchwefel Schwefel(100000);"}, {"page": 351, "x": 144.0, "y": 404.2, "text": "  Schwefel.Evaluate();"}, {"page": 351, "x": 144.0, "y": 428.6, "text": "  _tprintf_s(Schwefel.Elapsed());"}, {"page": 351, "x": 144.0, "y": 453.1, "text": "  CSchwefelMT SchwefelMT(100000);"}, {"page": 351, "x": 144.0, "y": 465.4, "text": "  SchwefelMT.Evaluate();"}, {"page": 351, "x": 144.0, "y": 489.8, "text": "  _tprintf_s(SchwefelMT.Elapsed());"}, {"page": 351, "x": 144.0, "y": 514.3, "text": "  CSchwefelP SchwefelP(100000);"}, {"page": 351, "x": 144.0, "y": 526.6, "text": "  SchwefelP.Evaluate();"}, {"page": 351, "x": 144.0, "y": 551.0, "text": "  _tprintf_s(SchwefelP.Elapsed());"}, {"page": 351, "x": 144.0, "y": 575.5, "text": "#ifdef _DEBUG"}, {"page": 351, "x": 144.0, "y": 587.8, "text": "  return system(\"pause\");"}, {"page": 351, "x": 144.0, "y": 600.0, "text": "#endif"}, {"page": 351, "x": 144.0, "y": 624.5, "text": "  return 0;"}, {"page": 351, "x": 144.0, "y": 636.7, "text": "}"}, {"page": 355, "x": 144.0, "y": 239.6, "text": "You can find more on OpenMP at http://openmp.org/wp/ or on"}, {"page": 355, "x": 144.0, "y": 252.4, "text": "http://msdn.microsoft.com/en-us/library/tt15eb9t.aspx"}]