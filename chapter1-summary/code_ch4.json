 159, "x": 144.0, "y": 563.8, "text": "  ShowWindow(hWnd, iWndShow);"}, {"page": 159, "x": 144.0, "y": 576.1, "text": "  UpdateWindow(hWnd);"}, {"page": 159, "x": 144.0, "y": 600.6, "text": "  MSG msg;"}, {"page": 159, "x": 144.0, "y": 612.8, "text": "  while (GetMessage(&msg, 0, 0, 0))"}, {"page": 159, "x": 144.0, "y": 625.0, "text": "  {"}, {"page": 159, "x": 144.0, "y": 637.3, "text": "    TranslateMessage(&msg);"}, {"page": 160, "x": 144.0, "y": 115.3, "text": "    DispatchMessage(&msg);"}, {"page": 160, "x": 144.0, "y": 127.5, "text": "  }"}, {"page": 160, "x": 144.0, "y": 149.6, "text": "  UnregisterClass(wndEx.lpszClassName, wndEx.hInstance);"}, {"page": 160, "x": 144.0, "y": 171.7, "text": "  return (int)msg.wParam;"}, {"page": 160, "x": 144.0, "y": 183.9, "text": "}"}, {"page": 160, "x": 144.0, "y": 206.0, "text": "LRESULT CALLBACK WindowProcedure(HWND hWnd, UINT uMsg, WPARAM"}, {"page": 160, "x": 144.0, "y": 216.8, "text": "wParam, LPARAM lParam)"}, {"page": 160, "x": 144.0, "y": 229.1, "text": "{"}, {"page": 160, "x": 144.0, "y": 241.3, "text": "  switch (uMsg)"}, {"page": 160, "x": 144.0, "y": 253.5, "text": "  {"}, {"page": 160, "x": 144.0, "y": 265.8, "text": "    case WM_COMMAND:"}, {"page": 160, "x": 144.0, "y": 278.0, "text": "    {"}, {"page": 160, "x": 144.0, "y": 290.2, "text": "      switch (LOWORD(wParam))"}, {"page": 160, "x": 144.0, "y": 302.5, "text": "      {"}, {"page": 160, "x": 144.0, "y": 314.7, "text": "        case BUTTON_MSG:"}, {"page": 160, "x": 144.0, "y": 327.0, "text": "        {"}, {"page": 160, "x": 144.0, "y": 339.2, "text": "          MessageBox(hWnd, _T(\"Hello!\"), _T(\"Basic MPI\"), MB_OK |"}, {"page": 160, "x": 144.0, "y": 350.0, "text": "MB_TOPMOST);"}, {"page": 160, "x": 144.0, "y": 362.2, "text": "          break;"}, {"page": 160, "x": 144.0, "y": 374.5, "text": "        }"}, {"page": 160, "x": 144.0, "y": 386.7, "text": "        case BUTTON_CLOSE:"}, {"page": 160, "x": 144.0, "y": 399.0, "text": "        {"}, {"page": 160, "x": 144.0, "y": 411.2, "text": "          PostMessage(hWnd, WM_CLOSE, 0, 0);"}, {"page": 160, "x": 144.0, "y": 423.4, "text": "          break;"}, {"page": 160, "x": 144.0, "y": 435.7, "text": "        }"}, {"page": 160, "x": 144.0, "y": 447.9, "text": "      }"}, {"page": 160, "x": 144.0, "y": 460.2, "text": "      break;"}, {"page": 160, "x": 144.0, "y": 472.4, "text": "    }"}, {"page": 160, "x": 144.0, "y": 494.5, "text": "    case WM_MOUSEMOVE:"}, {"page": 160, "x": 144.0, "y": 506.7, "text": "    {"}, {"page": 160, "x": 144.0, "y": 519.0, "text": "      int xPos = GET_X_LPARAM(lParam);"}, {"page": 160, "x": 144.0, "y": 531.2, "text": "      int yPos = GET_Y_LPARAM(lParam);"}, {"page": 160, "x": 144.0, "y": 553.3, "text": "      TCHAR szBuffer[4096];"}, {"page": 160, "x": 144.0, "y": 565.5, "text": "      wsprintf(szBuffer,"}, {"page": 160, "x": 144.0, "y": 577.8, "text": "        _T(\"\\n\\n\\t%ws\\t%d\\n\\t%ws\\t%d\"),"}, {"page": 160, "x": 144.0, "y": 590.0, "text": "        _T(\"Cursor X position:\"), xPos,"}, {"page": 160, "x": 144.0, "y": 602.2, "text": "        _T(\"Cursor Y position:\"), yPos);"}, {"page": 160, "x": 144.0, "y": 624.3, "text": "      HWND hText = GetDlgItem(hWnd, LABEL_TEXT);"}, {"page": 160, "x": 144.0, "y": 636.6, "text": "      SetWindowText(hText, szBuffer);"}, {"page": 160, "x": 144.0, "y": 648.8, "text": "      break;"}, {"page": 161, "x": 144.0, "y": 115.3, "text": "    }"}, {"page": 161, "x": 144.0, "y": 127.5, "text": "    case WM_DESTROY:"}, {"page": 161, "x": 144.0, "y": 139.8, "text": "    {"}, {"page": 161, "x": 144.0, "y": 152.0, "text": "      PostQuitMessage(0);"}, {"page": 161, "x": 144.0, "y": 164.3, "text": "      break;"}, {"page": 161, "x": 144.0, "y": 176.5, "text": "    }"}, {"page": 161, "x": 144.0, "y": 188.7, "text": "    default:"}, {"page": 161, "x": 144.0, "y": 201.0, "text": "    {"}, {"page": 161, "x": 144.0, "y": 213.2, "text": "      return DefWindowProc(hWnd, uMsg, wParam, lParam);"}, {"page": 16