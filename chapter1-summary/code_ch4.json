6.8, "text": "NULL);"}, {"page": 165, "x": 144.0, "y": 331.3, "text": "  if (!hWnd)"}, {"page": 165, "x": 144.0, "y": 343.5, "text": "  {"}, {"page": 165, "x": 144.0, "y": 355.8, "text": "    return NULL;"}, {"page": 165, "x": 144.0, "y": 368.0, "text": "  }"}, {"page": 165, "x": 144.0, "y": 392.5, "text": "  HFONT hFont = CreateFont(14, 0, 0, 0, FW_NORMAL, FALSE,"}, {"page": 165, "x": 144.0, "y": 404.7, "text": "    FALSE, FALSE, BALTIC_CHARSET, OUT_DEFAULT_PRECIS,"}, {"page": 165, "x": 144.0, "y": 417.0, "text": "    CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH |"}, {"page": 165, "x": 144.0, "y": 429.2, "text": "    FF_MODERN, _T(\"Microsoft Sans Serif\"));"}, {"page": 165, "x": 144.0, "y": 453.7, "text": "  HWND hText = CreateWindow(_T(\"STATIC\"), NULL, WS_CHILD |"}, {"page": 165, "x": 144.0, "y": 465.9, "text": "    WS_VISIBLE | SS_LEFT | WS_BORDER, 15, 20, 390, 220, hWnd,"}, {"page": 165, "x": 144.0, "y": 478.2, "text": "    (HMENU)LABEL_TEXT, wndEx.hInstance, NULL);"}, {"page": 165, "x": 144.0, "y": 502.6, "text": "  SendMessage(hText, WM_SETFONT, (WPARAM)hFont, TRUE);"}, {"page": 165, "x": 144.0, "y": 527.1, "text": "  ShowWindow(hWnd, iWndShow);"}, {"page": 165, "x": 144.0, "y": 551.6, "text": "  MSG msg;"}, {"page": 165, "x": 144.0, "y": 563.8, "text": "  while (GetMessage(&msg, 0, 0, 0))"}, {"page": 165, "x": 144.0, "y": 576.1, "text": "  {"}, {"page": 165, "x": 144.0, "y": 588.3, "text": "    TranslateMessage(&msg);"}, {"page": 165, "x": 144.0, "y": 600.6, "text": "    DispatchMessage(&msg);"}, {"page": 166, "x": 144.0, "y": 115.3, "text": "  }"}, {"page": 166, "x": 144.0, "y": 139.8, "text": "  UnregisterClass(wndEx.lpszClassName, wndEx.hInstance);"}, {"page": 166, "x": 144.0, "y": 164.3, "text": "  WaitForMultipleObjects(THREAD_NUMBER, hThreads, TRUE, INFINITE);"}, {"page": 166, "x": 144.0, "y": 188.7, "text": "  for (int iIndex = 0; iIndex < THREAD_NUMBER; iIndex++)"}, {"page": 166, "x": 144.0, "y": 201.0, "text": "  {"}, {"page": 166, "x": 144.0, "y": 213.2, "text": "    CloseHandle(hThreads[iIndex]);"}, {"page": 166, "x": 144.0, "y": 225.5, "text": "  }"}, {"page": 166, "x": 144.0, "y": 249.9, "text": "  WaitForSingleObject(hThread, INFINITE);"}, {"page": 166, "x": 144.0, "y": 274.4, "text": "  CloseHandle(hThread);"}, {"page": 166, "x": 144.0, "y": 286.6, "text": "  CloseHandle(gEvent);"}, {"page": 166, "x": 144.0, "y": 311.1, "text": "  DeleteCriticalSection(&cs);"}, {"page": 166, "x": 144.0, "y": 335.6, "text": "  return (int)msg.wParam;"}, {"page": 166, "x": 144.0, "y": 347.8, "text": "}"}, {"page": 166, "x": 144.0, "y": 372.3, "text": "LRESULT CALLBACK WindowProcedure(HWND hWnd, UINT uMsg, WPARAM"}, {"page": 166, "x": 144.0, "y": 383.1, "text": "wParam, LPARAM lParam)"}, {"page": 166, "x": 144.0, "y": 395.4, "text": "{"}, {"page": 166, "x": 144.0, "y": 407.6, "text": "  switch (uMsg)"}, {"page": 166, "x": 144.0, "y": 419.8, "text": "  {"}, {"page": 166, "x": 144.0, "y": 432.1, "text": "    case WM_CREATE:"}, {"page": 166, "x": 144.0, "y": 444.3, "text": "    {"}, {"page": 166, "x": 144.0, "y": 456.6, "text": "      gEvent = CreateEvent(NULL, TRUE, FALSE, EVENT_NAME);"}, {"page": 166, "x": 144.0, "y": 481.0, "text": "      for (int iIndex = 0; iIndex < THREAD_NUMBER; iIndex++)"}, {"page": 166, "x": 144.0, "y": 493.3, "text": "      {"}, {"page": 166, "x": 144.0, "y": 505.5, "text": "        hThreads[iIndex] = CreateThread(NULL, 0,"}, {"page": 166, "x": 144.0, "y": 517.8, "text": "         (LPTHREAD_START_ROUTINE)StartAddress, hWnd, 0, NULL);"}, {"page": 166, "x": 144.0, "y": 530.0, "text": "      }"}, {"page": 166, "x": 144.0, "y": 554.5, "text": "      hThread = CreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)"}, {"page": 166, "x": 144.0, "y": 565.3, "text": "DrawPlot, hWnd, 0, NULL);"}, {"page": 166, "x": 144.0, "y": 577.5, "text": "      break;"}, {"page": 166, "x": 144.0, "y": 589.8, "text": "    }"}, {"page": 166, "x": 144.0, "y": 602.0, "text": "    case WM_PLOTDATA:"}, {"page": 167, "x": 144.0, "y": 115.3, "text": "    {"}, {"page": 167, "x": 144.0, "y": 127.5, "text": "      PPLOTDATA pData = (PPLOTDATA)lParam;"}, {"page": 167, "x": 144.0, "y": 152.0, "text": "      HWND hLabel = GetDlgItem(hWnd, LABEL_TEXT);"}, {"page": 167, "x": 144.0, "y": 176.5, "text": "      TCHAR szBuffer[BUFFER_SIZE];"}, {"page": 167, "x": 144.0, "y": 188.7, "text": "      GetWindowText(hLabel, szBuffer, BUFFER_SIZE);"}, {"page": 167, "x": 144.0, "y": 213.2, "text": "      wsprintf(szBuffer,"}, {"page": 167, "x": 144.0, "y": 225.5, "text": "        _T(\"%ws\\n\\n\\tMessage has been received. Msg ID:\\t%d\"),"}, {"page": 167, "x": 144.0, "y": 237.7, "text": "        szBuffer, pData->iMsgID);"}, {"page": 167, "x": 144.0, "y": 249.9, "text": "      SetWindowText(hLabel, szBuffer);"}, {"page": 167, "x": 144.0, "y": 274.4, "text": "      break;"}, {"page": 167, "x": 144.0, "y": 286.6, "text": "    }"}, {"page": 167, "x": 144.0, "y": 298.9, "text": "    case WM_ENDTASK:"}, {"page": 167, "x": 144.0, "y": 311.1, "text": "    {"}, {"page": 167, "x": 144.0, "y": 323.4, "text": "      HWND hLabel = GetDlgItem(hWnd, LABEL_TEXT);"}, {"page": 167, "x": 144.0, "y": 347.8, "text": "      TCHAR szBuffer[BUFFER_SIZE];"}, {"page": 167, "x": 144.0, "y": 372.3, "text": "      wsprintf(szBuffer,"}, {"page": 167, "x": 144.0, "y": 384.6, "text": "        _T(\"\\n\\n\\tPlot is drawn. You can close the window now.\"));"}, {"page": 167, "x": 144.0, "y": 396.8, "text": "      SetWindowText(hLabel, szBuffer);"}, {"page": 167, "x": 144.0, "y": 409.0, "text": "      break;"}, {"page": 167, "x": 144.0, "y": 421.3, "text": "    }"}, {"page": 167, "x": 144.0, "y": 433.5, "text": "    case WM_DESTROY:"}, {"page": 167, "x": 144.0, "y": 445.8, "text": "    {"}, {"page": 167, "x": 144.0, "y": 458.0, "text": "      PostQuitMessage(0);"}, {"page": 167, "x": 144.0, "y": 470.2, "text": "      break;"}, {"page": 167, "x": 144.0, "y": 482.5, "text": "    }"}, {"page": 167, "x": 144.0, "y": 494.7, "text": "    default:"}, {"page": 167, "x": 144.0, "y": 507.0, "text": "    {"}, {"page": 167, "x": 144.0, "y": 519.2, "text": "      return DefWindowProc(hWnd, uMsg, wParam, lParam);"}, {"page": 167, "x": 144.0, "y": 531.4, "text": "    }"}, {"page": 167, "x": 144.0, "y": 543.7, "text": "  }"}, {"page": 167, "x": 144.0, "y": 568.2, "text": "  return 0;"}, {"page": 167, "x": 144.0, "y": 580.4, "text": "}"}, {"page": 167, "x": 144.0, "y": 604.9, "text": "DWORD WINAPI StartAddress(LPVOID lpParameter)"}, {"page": 167, "x": 144.0, "y": 617.1, "text": "{"}, {"page": 167, "x": 144.0, "y": 629.4, "text": "  HWND hWnd = (HWND)lpParameter;"}, {"page": 168, "x": 144.0, "y": 115.3, "text": "  HANDLE hEvent = OpenEvent(EVENT_ALL_ACCESS, FALSE, EVENT_NAME);"}, {"page": 168, "x": 144.0, "y": 139.8, "text": "  if (hEvent != NULL)"}, {"page": 168, "x": 144.0, "y": 152.0, "text": "  {"}, {"page": 168, "x": 144.0, "y": 164.3, "text": "    SetEvent(hEvent);"}, {"page": 168, "x": 144.0, "y": 176.5, "text": "  }"}, {"page": 168, "x": 144.0, "y": 201.0, "text": "  CloseHandle(hEvent);"}, {"page": 168, "x": 144.0, "y": 225.5, "text": "  int iCount = 0;"}, {"page": 168, "x": 144.0, "y": 237.7, "text": "  while (iCount++ < MAX_MSGCOUNT)"}, {"page": 168, "x": 144.0, "y": 249.9, "text": "  {"}, {"page": 168, "x": 144.0, "y": 262.2, "text": "    // perform calculation"}, {"page": 168, "x": 144.0, "y": 274.4, "text": "    Sleep(CALCULATION_TIME);"}, {"page": 168, "x": 144.0, "y": 298.9, "text": "    // assembly result into PLOTDATA structure"}, {"page": 168, "x": 144.0, "y": 311.1, "text": "    PPLOTDATA pData = new PLOTDATA();"}, {"page": 168, "x": 144.0, "y": 323.4, "text": "    pData->value = (rand() % 0xFFFF) - iMessageID;"}, {"page": 168, "x": 144.0, "y": 335.6, "text": "    pData->dwThreadId = GetCurrentThreadId();"}, {"page": 168, "x": 144.0, "y": 347.8, "text": "    pData->iMsgID = ++iMessageID;"}, {"page": 168, "x": 144.0, "y": 372.3, "text": "    EnterCriticalSection(&cs);"}, {"page": 168, "x": 144.0, "y": 384.6, "text": "    queue.Enqueue(pData);"}, {"page": 168, "x": 144.0, "y": 396.8, "text": "    LeaveCriticalSection(&cs);"}, {"page": 168, "x": 144.0, "y": 421.3, "text": "    PostMessage(hWnd, WM_PLOTDATA, 0, (LPARAM)pData);"}, {"page": 168, "x": 144.0, "y": 433.5, "text": "  }"}, {"page": 168, "x": 144.0, "y": 458.0, "text": "  return 0L;"}, {"page": 168, "x": 144.0, "y": 470.2, "text": "}"}, {"page": 168, "x": 144.0, "y": 494.7, "text": "DWORD WINAPI DrawPlot(LPVOID lpParameter)"}, {"page": 168, "x": 144.0, "y": 507.0, "text": "{"}, {"page": 168, "x": 144.0, "y": 519.2, "text": "  HWND hWnd = (HWND)lpParameter;"}, {"page": 168, "x": 144.0, "y": 543.7, "text": "  HANDLE hEvent = OpenEvent(EVENT_ALL_ACCESS, FALSE, EVENT_NAME);"}, {"page": 168, "x": 144.0, "y": 568.2, "text": "  WaitForSingleObject(hEvent, INFINITE);"}, {"page": 168, "x": 144.0, "y": 580.4, "text": "  CloseHandle(hEvent);"}, {"page": 168, "x": 144.0, "y": 600.1, "text": "  int iCount = 0;"}, {"page": 168, "x": 144.0, "y": 612.3, "text": "  while (iCount++ < MAX_MSGCOUNT * THREAD_NUMBER)"}, {"page": 168, "x": 144.0, "y": 624.6, "text": "  {"}, {"page": 168, "x": 144.0, "y": 636.8, "text": "    EnterCriticalSection(&cs);"}, {"page": 169, "x": 144.0, "y": 114.9, "text": "    PPLOTDATA pData = queue.Dequeue();"}, {"page": 169, "x": 144.0, "y": 127.2, "text": "    LeaveCriticalSection(&cs);"}, {"page": 169, "x": 144.0, "y": 146.8, "text": "    if (!pData)"}, {"page": 169, "x": 144.0, "y": 159.1, "text": "    {"}, {"page": 169, "x": 144.0, "y": 171.3, "text": "      break;"}, {"page": 169, "x": 144.0, "y": 183.6, "text": "    }"}, {"page": 169, "x": 144.0, "y": 203.3, "text": "    // perform drawing"}, {"page": 169, "x": 144.0, "y": 215.5, "text": "    Sleep(DRAWING_TIME);"}, {"page": 169, "x": 144.0, "y": 235.2, "text": "    HWND hLabel = GetDlgItem(hWnd, LABEL_TEXT);"}, {"page": 169, "x": 144.0, "y": 254.8, "text": "    TCHAR szBuffer[BUFFER_SIZE];"}, {"page": 169, "x": 144.0, "y": 274.5, "text": "  wsprintf(szBuffer,"}, {"page": 169, "x": 144.0, "y": 286.8, "text": "#ifdef _UNICODE"}, {"page": 169, "x": 144.0, "y": 299.0, "text": "    _T(\"\\n\\n\\t%ws\\t%u\\n\\t%ws\\t%d\\n\\t%ws\\t%d\"),"}, {"page": 169, "x": 144.0, "y": 311.2, "text": "#else"}, {"page": 169, "x": 144.0, "y": 323.5, "text": "    _T(\"\\n\\n\\t%s\\t%u\\n\\t%s\\t%d\\n\\t%s\\t%d\"),"}, {"page": 169, "x": 144.0, "y": 335.7, "text": "#endif"}, {"page": 169, "x": 144.0, "y": 348.0, "text": "    _T(\"Thread ID:\"), (DWORD)pData->dwThreadId,"}, {"page": 169, "x": 144.0, "y": 360.2, "text": "    _T(\"Current value:\"), (int)pData->value,"}, {"page": 169, "x": 144.0, "y": 372.4, "text": "    _T(\"Message ID:\"), pData->iMsgID);"}, {"page": 169, "x": 144.0, "y": 384.7, "text": "    SetWindowText(hLabel, szBuffer);"}, {"page": 169, "x": 144.0, "y": 404.4, "text": "    delete pData;"}, {"page": 169, "x": 144.0, "y": 416.6, "text": "  }"}, {"page": 169, "x": 144.0, "y": 436.3, "text": "  PostMessage(hWnd, WM_ENDTASK, 0, 0);"}, {"page": 169, "x": 144.0, "y": 456.0, "text": "  return 0L;"}, {"page": 169, "x": 144.0, "y": 468.2, "text": "}"}, {"page": 169, "x": 144.0, "y": 575.8, "text": "WM_PLOTDATA for the calculation thread to inform the main thread that calculation"}, {"page": 169, "x": 144.0, "y": 604.1, "text": "WM_ENDTASK to inform the main thread that all the drawing has been completed"}, {"page": 170, "x": 126.0, "y": 172.1, "text": "SetWindowLongPtr(hWnd, GWLP_USERDATA, (LONG_PTR) &queue);"}, {"page": 170, "x": 126.0, "y": 260.2, "text": "  CQueue<PLOTDATA>* plotPtr = (CQueue<PLOTDATA>*)"}, {"page": 170, "x": 126.0, "y": 271.0, "text": "GetWindowLongPtr( hWnd, GWLP_USERDATA );"}, {"page": 171, "x": 126.0, "y": 413.4, "text": "1.\t Create a new empty C++ Windows application named threadMPI."}, {"page": 171, "x": 144.0, "y": 441.7, "text": "file CQueue.h from the Chapter 1, Introduction to C++ Concepts and Features."}, {"page": 171, "x": 144.0, "y": 470.1, "text": "named threadMPI. Open threadMPI.cpp."}, {"page": 171, "x": 144.0, "y": 503.3, "text": "#include <windows.h>"}, {"page": 171, "x": 144.0, "y": 515.6, "text": "#include <windowsx.h>"}, {"page": 171, "x": 144.0, "y": 527.8, "text": "#include <tchar.h>"}, {"page": 171, "x": 144.0, "y": 540.0, "text": "#include \"CQueue.h\""}, {"page": 171, "x": 144.0, "y": 552.3, "text": "#include <commctrl.h>"}, {"page": 171, "x": 144.0, "y": 576.8, "text": "#pragma comment ( lib, \"comctl32.lib\" )"}, {"page": 172, "x": 144.0, "y": 115.3, "text": "#pragma comment ( linker, \"\\\"/manifestdependency:type='win32' \\"}, {"page": 172, "x": 144.0, "y": 127.5, "text": "name='Microsoft.Windows.Common-Controls' \\"}, {"page": 172, "x": 144.0, "y": 139.8, "text": "version='6.0.0.0' processorArchitecture='*' \\"}, {"page": 172, "x": 144.0, "y": 152.0, "text": "publicKeyToken='6595b64144ccf1df' language='*'\\\"\" )"}, {"page": 172, "x": 144.0, "y": 176.5, "text": "#define BUFFER_SIZE    4096"}, {"page": 172, "x": 144.0, "y": 201.0, "text": "#define BUTTON_CLOSE  100"}, {"page": 172, "x": 144.0, "y": 225.5, "text": "#define T_MESSAGE    WM_USER    + 1"}, {"page": 172, "x": 144.0, "y": 237.7, "text": "#define T_ENDTASK    T_MESSAGE  + 1"}, {"page": 172, "x": 144.0, "y": 262.2, "text": "#define EVENT_NAME    _T( \"__t_event__\" )"}, {"page": 172, "x": 144.0, "y": 286.6, "text": "LRESULT CALLBACK WindowProcedure(HWND hWnd, UINT uMsg, WPARAM"}, {"page": 172, "x": 144.0, "y": 297.4, "text": "wParam, LPARAM lParam);"}, {"page": 172, "x": 144.0, "y": 309.7, "text": "DWORD WINAPI StartAddress(LPVOID lpParameter);"}, {"page": 172, "x": 144.0, "y": 334.2, "text": "int WINAPI _tWinMain(HINSTANCE hThis, HINSTANCE hPrev, LPTSTR"}, {"page": 172, "x": 144.0, "y": 345.0, "text": "szCommandLine, int iWndShow)"}, {"page": 172, "x": 144.0, "y": 357.2, "text": "{"}, {"page": 172, "x": 144.0, "y": 369.4, "text": "  UNREFERENCED_PARAMETER(hPrev);"}, {"page": 172, "x": 144.0, "y": 381.7, "text": "  UNREFERENCED_PARAMETER(szCommandLine);"}, {"page": 172, "x": 144.0, "y": 406.2, "text": "  TCHAR* szWindowClass = _T(\"__basic_MPI_wnd_class__\");"}, {"page": 172, "x": 144.0, "y": 430.6, "text": "  WNDCLASSEX wndEx = { 0 };"}, {"page": 172, "x": 144.0, "y": 442.9, "text": "  wndEx.cbSize = sizeof(WNDCLASSEX);"}, {"page": 172, "x": 144.0, "y": 455.1, "text": "  wndEx.style = CS_HREDRAW | CS_VREDRAW;"}, {"page": 172, "x": 144.0, "y": 467.4, "text": "  wndEx.lpfnWndProc = WindowProcedure;"}, {"page": 172, "x": 144.0, "y": 479.6, "text": "  wndEx.cbClsExtra = 0;"}, {"page": 172, "x": 144.0, "y": 491.8, "text": "  wndEx.cbWndExtra = 0;"}, {"page": 172, "x": 144.0, "y": 504.1, "text": "  wndEx.hInstance = hThis;"}, {"page": 172, "x": 144.0, "y": 516.3, "text": "  wndEx.hIcon = LoadIcon(wndEx.hInstance,"}, {"page": 172, "x": 144.0, "y": 528.6, "text": "    MAKEINTRESOURCE(IDI_APPLICATION));"}, {"page": 172, "x": 144.0, "y": 540.8, "text": "  wndEx.hCursor = LoadCursor(NULL, IDC_ARROW);"}, {"page": 172, "x": 144.0, "y": 553.0, "text": "  wndEx.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);"}, {"page": 172, "x": 144.0, "y": 565.3, "text": "  wndEx.lpszMenuName = NULL;"}, {"page": 172, "x": 144.0, "y": 577.5, "text": "  wndEx.lpszClassName = szWindowClass;"}, {"page": 173, "x": 144.0, "y": 115.3, "text": "  wndEx.hIconSm = LoadIcon(wndEx.hInstance,"}, {"page": 173, "x": 144.0, "y": 127.5, "text": "    MAKEINTRESOURCE(IDI_APPLICATION));"}, {"page": 173, "x": 144.0, "y": 152.0, "text": "  if (!RegisterClassEx(&wndEx))"}, {"page": 173, "x": 144.0, "y": 164.3, "text": "  {"}, {"page": 173, "x": 144.0, "y": 176.5, "text": "    return 1;"}, {"page": 173, "x": 144.0, "y": 188.7, "text": "  }"}, {"page": 173, "x": 144.0, "y": 213.2, "text": "  InitCommonControls();"}, {"page": 173, "x": 144.0, "y": 237.7, "text": "  HWND hWnd = CreateWindow(szWindowClass, _T(\"Basic Message"}, {"page": 173, "x": 144.0, "y": 248.5, "text": "Passing Interface\"), WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU |"}, {"page": 173, "x": 144.0, "y": 259.3, "text": "WS_MINIMIZEBOX, 200, 200, 440, 300, NULL, NULL, wndEx.hInstance,"}, {"page": 173, "x": 144.0, "y": 270.1, "text": "NULL);"}, {"page": 173, "x": 144.0, "y": 294.6, "text": "  if (!hWnd)"}, {"page": 173, "x": 144.0, "y": 306.8, "text": "  {"}, {"page": 173, "x": 144.0, "y": 319.0, "text": "    return NULL;"}, {"page": 173, "x": 144.0, "y": 331.3, "text": "  }"}, {"page": 173, "x": 144.0, "y": 355.8, "text": "  HFONT hFont = CreateFont(14, 0, 0, 0, FW_NORMAL, FALSE,"}, {"page": 173, "x": 144.0, "y": 368.0, "text": "    FALSE, FALSE, BALTIC_CHARSET, OUT_DEFAULT_PRECIS,"}, {"page": 173, "x": 144.0, "y": 380.2, "text": "    CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH |"}, {"page": 173, "x": 144.0, "y": 392.5, "text": "    FF_MODERN, _T(\"Microsoft Sans Serif\"));"}, {"page": 173, "x": 144.0, "y": 417.0, "text": "  HWND hButton = CreateWindow(_T(\"BUTTON\"), _T(\"Send message\"),"}, {"page": 173, "x": 144.0, "y": 427.8, "text": "WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON | WS_TABSTOP, 310, 210, 100,"}, {"page": 173, "x": 144.0, "y": 438.6, "text": "25, hWnd, (HMENU)BUTTON_CLOSE, wndEx.hInstance, NULL);"}, {"page": 173, "x": 144.0, "y": 463.0, "text": "  SendMessage(hButton, WM_SETFONT, (WPARAM)hFont, TRUE);"}, {"page": 173, "x": 144.0, "y": 487.5, "text": "  ShowWindow(hWnd, iWndShow);"}, {"page": 173, "x": 144.0, "y": 512.0, "text": "  HANDLE hEvent = CreateEvent(NULL, TRUE, FALSE, EVENT_NAME);"}, {"page": 173, "x": 144.0, "y": 536.5, "text": "  DWORD dwThreadId = 0;"}, {"page": 173, "x": 144.0, "y": 561.0, "text": "  HANDLE hThread = CreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)"}, {"page": 173, "x": 144.0, "y": 571.8, "text": "StartAddress, hWnd, 0, &dwThreadId);"}, {"page": 173, "x": 144.0, "y": 596.2, "text": "  SetWindowLongPtr(hWnd, GWLP_USERDATA, (LONG_PTR)&dwThreadId);"}, {"page": 173, "x": 144.0, "y": 620.7, "text": "  WaitForSingleObject(hEvent, INFINITE);"}, {"page": 174, "x": 144.0, "y": 115.3, "text": "  CloseHandle(hEvent);"}, {"page": 174, "x": 144.0, "y": 139.8, "text": "  MSG msg;"}, {"page": 174, "x": 144.0, "y": 152.0, "text": "  while (GetMessage(&msg, 0, 0, 0))"}, {"page": 174, "x": 144.0, "y": 164.3, "text": "  {"}, {"page": 174, "x": 144.0, "y": 176.5, "text": "    TranslateMessage(&msg);"}, {"page": 174, "x": 144.0, "y": 188.7, "text": "    DispatchMessage(&msg);"}, {"page": 174, "x": 144.0, "y": 201.0, "text": "  }"}, {"page": 174, "x": 144.0, "y": 225.5, "text": "  UnregisterClass(wndEx.lpszClassName, wndEx.hInstance);"}, {"page": 174, "x": 144.0, "y": 249.9, "text": "  PostThreadMessage(dwThreadId, T_ENDTASK, 0, 0);"}, {"page": 174, "x": 144.0, "y": 262.2, "text": "  WaitForSingleObject(hThread, INFINITE);"}, {"page": 174, "x": 144.0, "y": 286.6, "text": "  CloseHandle(hThread);"}, {"page": 174, "x": 144.0, "y": 298.9, "text": "  return (int)msg.wParam;"}, {"page": 174, "x": 144.0, "y": 311.1, "text": "}"}, {"page": 174, "x": 144.0, "y": 335.6, "text": "LRESULT CALLBACK WindowProcedure(HWND hWnd, UINT uMsg, WPARAM"}, {"page": 174, "x": 144.0, "y": 346.4, "text": "wParam, LPARAM lParam)"}, {"page": 174, "x": 144.0, "y": 358.6, "text": "{"}, {"page": 174, "x": 144.0, "y": 370.9, "text": "  switch (uMsg)"}, {"page": 174, "x": 144.0, "y": 383.1, "text": "  {"}, {"page": 174, "x": 144.0, "y": 395.4, "text": "    case WM_COMMAND:"}, {"page": 174, "x": 144.0, "y": 407.6, "text": "    {"}, {"page": 174, "x": 144.0, "y": 419.8, "text": "      switch (LOWORD(wParam))"}, {"page": 174, "x": 144.0, "y": 432.1, "text": "      {"}, {"page": 174, "x": 144.0, "y": 444.3, "text": "        case BUTTON_CLOSE:"}, {"page": 174, "x": 144.0, "y": 456.6, "text": "        {"}, {"page": 174, "x": 144.0, "y": 468.8, "text": "          DWORD* pdwThreadId = (DWORD*)GetWindowLongPtr(hWnd,"}, {"page": 174, "x": 144.0, "y": 479.6, "text": "GWLP_USERDATA);"}, {"page": 174, "x": 144.0, "y": 491.8, "text": "          PostThreadMessage(*pdwThreadId, T_MESSAGE, 0, 0);"}, {"page": 174, "x": 144.0, "y": 504.1, "text": "          break;"}, {"page": 174, "x": 144.0, "y": 516.3, "text": "        }"}, {"page": 174, "x": 144.0, "y": 528.6, "text": "      }"}, {"page": 174, "x": 144.0, "y": 540.8, "text": "      break;"}, {"page": 174, "x": 144.0, "y": 553.0, "text": "    }"}, {"page": 174, "x": 144.0, "y": 565.3, "text": "    case WM_DESTROY:"}, {"page": 174, "x": 144.0, "y": 577.5, "text": "    {"}, {"page": 174, "x": 144.0, "y": 589.8, "text": "      PostQuitMessage(0);"}, {"page": 174, "x": 144.0, "y": 602.0, "text": "      break;"}, {"page": 175, "x": 144.0, "y": 115.3, "text": "    }"}, {"page": 175, "x": 144.0, "y": 127.5, "text": "    default:"}, {"page": 175, "x": 144.0, "y": 139.8, "text": "    {"}, {"page": 175, "x": 144.0, "y": 152.0, "text": "      return DefWindowProc(hWnd, uMsg, wParam, lParam);"}, {"page": 175, "x": 144.0, "y": 164.3, "text": "    }"}, {"page": 175, "x": 144.0, "y": 176.5, "text": "  }"}, {"page": 175, "x": 144.0, "y": 188.7, "text": "  return 0;"}, {"page": 175, "x": 144.0, "y": 201.0, "text": "}"}, {"page": 175, "x": 144.0, "y": 225.5, "text": "DWORD WINAPI StartAddress(LPVOID lpParameter)"}, {"page": 175, "x": 144.0, "y": 237.7, "text": "{"}, {"page": 175, "x": 144.0, "y": 249.9, "text": "  MSG msg;"}, {"page": 175, "x": 144.0, "y": 262.2, "text": "  PeekMessage(&msg, NULL, WM_USER, WM_USER, PM_NOREMOVE);"}, {"page": 175, "x": 144.0, "y": 286.6, "text": "  HANDLE hEvent = OpenEvent(EVENT_ALL_ACCESS, FALSE, EVENT_NAME);"}, {"page": 175, "x": 144.0, "y": 311.1, "text": "  if (hEvent != NULL)"}, {"page": 175, "x": 144.0, "y": 323.4, "text": "  {"}, {"page": 175, "x": 144.0, "y": 335.6, "text": "    SetEvent(hEvent);"}, {"page": 175, "x": 144.0, "y": 347.8, "text": "  }"}, {"page": 175, "x": 144.0, "y": 360.1, "text": "  CloseHandle(hEvent);"}, {"page": 175, "x": 144.0, "y": 384.6, "text": "  while (GetMessage(&msg, NULL, 0, 0))"}, {"page": 175, "x": 144.0, "y": 396.8, "text": "  {"}, {"page": 175, "x": 144.0, "y": 409.0, "text": "    switch (msg.message)"}, {"page": 175, "x": 144.0, "y": 421.3, "text": "    {"}, {"page": 175, "x": 144.0, "y": 433.5, "text": "      case T_MESSAGE:"}, {"page": 175, "x": 144.0, "y": 445.8, "text": "      {"}, {"page": 175, "x": 144.0, "y": 458.0, "text": "        // TO DO"}, {"page": 175, "x": 144.0, "y": 470.2, "text": "        // add some message processing here"}, {"page": 175, "x": 144.0, "y": 482.5, "text": "        MessageBox(NULL, _T(\"Hi.\\nI've just received a message.\"),"}, {"page": 175, "x": 144.0, "y": 493.3, "text": "_T(\"Thread\"), MB_OK);"}, {"page": 175, "x": 144.0, "y": 505.5, "text": "        break;"}, {"page": 175, "x": 144.0, "y": 517.8, "text": "      }"}, {"page": 175, "x": 144.0, "y": 530.0, "text": "      case T_ENDTASK:"}, {"page": 175, "x": 144.0, "y": 542.2, "text": "      {"}, {"page": 175, "x": 144.0, "y": 554.5, "text": "        // main thread is exiting"}, {"page": 175, "x": 144.0, "y": 566.7, "text": "        // return immediately"}, {"page": 175, "x": 144.0, "y": 579.0, "text": "        return 0L;"}, {"page": 175, "x": 144.0, "y": 591.2, "text": "      }"}, {"page": 175, "x": 144.0, "y": 603.4, "text": "    }"}, {"page": 175, "x": 144.0, "y": 615.7, "text": "  }"}, {"page": 175, "x": 144.0, "y": 627.9, "text": "  return 0L;"}, {"page": 175, "x": 144.0, "y": 640.2, "text": "}"}, {"page": 176, "x": 144.0, "y": 175.4, "text": "T_MESSAGE to notify the thread to start its specific task"}, {"page": 176, "x": 144.0, "y": 190.2, "text": "T_ENDTASK to notify the thread that the application is closing, and it needs to"}, {"page": 176, "x": 126.0, "y": 320.5, "text": "PeekMessage(&msg, NULL, WM_USER, WM_USER, PM_NOREMOVE);"}, {"page": 177, "x": 126.0, "y": 216.9, "text": "1.\t Create a new empty C++ Console application named pipe_server."}, {"page": 177, "x": 144.0, "y": 245.2, "text": "pipe_server. Open pipe_server.cpp."}, {"page": 177, "x": 144.0, "y": 278.5, "text": "#include <windows.h>"}, {"page": 177, "x": 144.0, "y": 290.7, "text": "#include <stdio.h>"}, {"page": 177, "x": 144.0, "y": 303.0, "text": "#include <tchar.h>"}, {"page": 177, "x": 144.0, "y": 327.4, "text": "#define BUFFER_SIZE 4096"}, {"page": 177, "x": 144.0, "y": 351.9, "text": "DWORD WINAPI StartAddress(LPVOID lpParameter);"}, {"page": 177, "x": 144.0, "y": 376.4, "text": "int _tmain(void)"}, {"page": 177, "x": 144.0, "y": 388.6, "text": "{"}, {"page": 177, "x": 144.0, "y": 400.9, "text": "  LPTSTR szPipename = _T(\"\\\\\\\\.\\\\pipe\\\\basicMPI\");"}, {"page": 177, "x": 144.0, "y": 425.4, "text": "  while (TRUE)"}, {"page": 177, "x": 144.0, "y": 437.6, "text": "  {"}, {"page": 177, "x": 144.0, "y": 449.8, "text": "    _tprintf(_T(\"basicMPI: waiting client connection\\n\"));"}, {"page": 177, "x": 144.0, "y": 474.3, "text": "  HANDLE hPipe = CreateNamedPipe(szPipename, PIPE_ACCESS_DUPLEX,"}, {"page": 177, "x": 144.0, "y": 486.6, "text": "    PIPE_WAIT | PIPE_READMODE_MESSAGE | PIPE_TYPE_MESSAGE,"}, {"page": 177, "x": 144.0, "y": 498.8, "text": "    PIPE_UNLIMITED_INSTANCES, BUFFER_SIZE, BUFFER_SIZE, 0,"}, {"page": 177, "x": 144.0, "y": 511.0, "text": "    NULL);"}, {"page": 177, "x": 144.0, "y": 535.5, "text": "    if (hPipe == INVALID_HANDLE_VALUE)"}, {"page": 177, "x": 144.0, "y": 547.8, "text": "    {"}, {"page": 177, "x": 144.0, "y": 560.0, "text": "      _tprintf(_T(\"CreateNamedPipe failed! Error code: [%u]\\n\"),"}, {"page": 177, "x": 144.0, "y": 570.8, "text": "GetLastError());"}, {"page": 177, "x": 144.0, "y": 583.0, "text": "      return 2;"}, {"page": 177, "x": 144.0, "y": 595.3, "text": "    }"}, {"page": 177, "x": 144.0, "y": 619.8, "text": "    if (ConnectNamedPipe(hPipe, NULL))"}, {"page": 177, "x": 144.0, "y": 632.0, "text": "    {"}, {"page": 178, "x": 144.0, "y": 115.3, "text": "      _tprintf(_T(\"Connection succeeded.\\n\"));"}, {"page": 178, "x": 144.0, "y": 137.4, "text": "     HANDLE hThread = CreateThread(NULL, 0,"}, {"page": 178, "x": 144.0, "y": 149.6, "text": "      (LPTHREAD_START_ROUTINE)StartAddress, hPipe, 0, NULL);"}, {"page": 178, "x": 144.0, "y": 171.7, "text": "      CloseHandle(hThread);"}, {"page": 178, "x": 144.0, "y": 183.9, "text": "    }"}, {"page": 178, "x": 144.0, "y": 196.2, "text": "  }"}, {"page": 178, "x": 144.0, "y": 218.3, "text": "  return 0;"}, {"page": 178, "x": 144.0, "y": 230.5, "text": "}"}, {"page": 178, "x": 144.0, "y": 252.6, "text": "DWORD WINAPI StartAddress(LPVOID lpParameter)"}, {"page": 178, "x": 144.0, "y": 264.8, "text": "{"}, {"page": 178, "x": 144.0, "y": 277.0, "text": "  HANDLE hPipe = (HANDLE)lpParameter;"}, {"page": 178, "x": 144.0, "y": 299.1, "text": "  PTCHAR szRequest = (PTCHAR)HeapAlloc(GetProcessHeap(), 0,"}, {"page": 178, "x": 144.0, "y": 309.9, "text": "    BUFFER_SIZE * sizeof(TCHAR));"}, {"page": 178, "x": 144.0, "y": 322.2, "text": "  PTCHAR szReply = (PTCHAR)HeapAlloc(GetProcessHeap(), 0,"}, {"page": 178, "x": 144.0, "y": 334.4, "text": "    BUFFER_SIZE * sizeof(TCHAR));"}, {"page": 178, "x": 144.0, "y": 346.6, "text": "  DWORD dwBytesRead = 0;"}, {"page": 178, "x": 144.0, "y": 358.9, "text": "  DWORD dwReplyBytes = 0;"}, {"page": 178, "x": 144.0, "y": 371.1, "text": "  DWORD dwBytesWritten = 0;"}, {"page": 178, "x": 144.0, "y": 393.2, "text": "  _tprintf(_T(\"Waiting messages.\\n\"));"}, {"page": 178, "x": 144.0, "y": 415.3, "text": "  if (!ReadFile(hPipe, szRequest, BUFFER_SIZE * sizeof(TCHAR),"}, {"page": 178, "x": 144.0, "y": 426.1, "text": "&dwBytesRead, NULL))"}, {"page": 178, "x": 144.0, "y": 438.3, "text": "  {"}, {"page": 178, "x": 144.0, "y": 450.6, "text": "    _tprintf(_T(\"ReadFile failed! Error code: [%u]\\n\"),"}, {"page": 178, "x": 144.0, "y": 461.4, "text": "GetLastError());"}, {"page": 178, "x": 144.0, "y": 473.6, "text": "    return 2L;"}, {"page": 178, "x": 144.0, "y": 485.8, "text": "  }"}, {"page": 178, "x": 144.0, "y": 507.9, "text": "  // do some processing"}, {"page": 178, "x": 144.0, "y": 530.0, "text": "  _tprintf(_T(\"Client request:\\\"%s\\\"\\n\"), szRequest);"}, {"page": 178, "x": 144.0, "y": 552.1, "text": "  _tcscpy_s(szReply, BUFFER_SIZE,"}, {"page": 178, "x": 144.0, "y": 564.3, "text": "    _T(\"default answer from server\"));"}, {"page": 178, "x": 144.0, "y": 586.4, "text": "  dwReplyBytes = (_tcslen(szReply) + 1) * sizeof(TCHAR);"}, {"page": 178, "x": 144.0, "y": 608.5, "text": "  if (!WriteFile(hPipe, szReply, dwReplyBytes, &dwBytesWritten,"}, {"page": 178, "x": 144.0, "y": 619.3, "text": "NULL))"}, {"page": 178, "x": 144.0, "y": 631.5, "text": "  {"}, {"page": 179, "x": 144.0, "y": 115.3, "text": "    _tprintf(_T(\"WriteFile failed! Error code: [%u]\"),"}, {"page": 179, "x": 144.0, "y": 126.1, "text": "GetLastError());"}, {"page": 179, "x": 144.0, "y": 138.3, "text": "    return 2L;"}, {"page": 179, "x": 144.0, "y": 150.6, "text": "  }"}, {"page": 179, "x": 144.0, "y": 172.6, "text": "  FlushFileBuffers(hPipe);"}, {"page": 179, "x": 144.0, "y": 184.9, "text": "  DisconnectNamedPipe(hPipe);"}, {"page": 179, "x": 144.0, "y": 197.1, "text": "  CloseHandle(hPipe);"}, {"page": 179, "x": 144.0, "y": 219.2, "text": "  HeapFree(GetProcessHeap(), 0, szRequest);"}, {"page": 179, "x": 144.0, "y": 231.5, "text": "  HeapFree(GetProcessHeap(), 0, szReply);"}, {"page": 179, "x": 144.0, "y": 253.5, "text": "  _tprintf(_T(\"Success.\\n\"));"}, {"page": 179, "x": 144.0, "y": 275.6, "text": "  return 0L;"}, {"page": 179, "x": 144.0, "y": 287.8, "text": "}"}, {"page": 179, "x": 144.0, "y": 318.7, "text": "C++ Console application named pipe_client."}, {"page": 179, "x": 144.0, "y": 347.0, "text": "named pipe_client. Open pipe_client.cpp."}, {"page": 179, "x": 144.0, "y": 380.2, "text": "#include <windows.h>"}, {"page": 179, "x": 144.0, "y": 392.5, "text": "#include <stdio.h>"}, {"page": 179, "x": 144.0, "y": 404.7, "text": "#include <tchar.h>"}, {"page": 179, "x": 144.0, "y": 426.8, "text": "#define BUFFER_SIZE 4096"}, {"page": 179, "x": 144.0, "y": 448.9, "text": "int _tmain(void)"}, {"page": 179, "x": 144.0, "y": 461.1, "text": "{"}, {"page": 179, "x": 144.0, "y": 473.4, "text": "  TCHAR szBuffer[BUFFER_SIZE];"}, {"page": 179, "x": 144.0, "y": 485.6, "text": "  DWORD dwRead = 0;"}, {"page": 179, "x": 144.0, "y": 497.8, "text": "  DWORD dwWritten = 0;"}, {"page": 179, "x": 144.0, "y": 510.1, "text": "  DWORD dwMode = PIPE_READMODE_MESSAGE;"}, {"page": 179, "x": 144.0, "y": 522.3, "text": "  LPTSTR szPipename = _T(\"\\\\\\\\.\\\\pipe\\\\basicMPI\");"}, {"page": 179, "x": 144.0, "y": 534.6, "text": "  LPTSTR szMessage = _T(\"Message from client.\");"}, {"page": 179, "x": 144.0, "y": 546.8, "text": "  DWORD dwToWrite = _tcslen(szMessage) * sizeof(TCHAR);"}, {"page": 179, "x": 144.0, "y": 568.9, "text": "  HANDLE hPipe = CreateFile(szPipename, GENERIC_READ |"}, {"page": 179, "x": 144.0, "y": 581.1, "text": "    GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);"}, {"page": 179, "x": 144.0, "y": 603.2, "text": "  WaitNamedPipe(szPipename, INFINITE);"}, {"page": 179, "x": 144.0, "y": 625.3, "text": "  SetNamedPipeHandleState(hPipe, &dwMode, NULL, NULL);"}, {"page": 179, "x": 144.0, "y": 647.4, "text": "  if (!WriteFile(hPipe, szMessage, dwToWrite, &dwWritten, NULL))"}, {"page": 180, "x": 144.0, "y": 115.3, "text": "  {"}, {"page": 180, "x": 144.0, "y": 127.5, "text": "    _tprintf(_T(\"WriteFile failed! Error code: [%u]\\n\"),"}, {"page": 180, "x": 144.0, "y": 138.3, "text": "GetLastError());"}, {"page": 180, "x": 144.0, "y": 150.6, "text": "    return -1;"}, {"page": 180, "x": 144.0, "y": 162.8, "text": "  }"}, {"page": 180, "x": 144.0, "y": 187.3, "text": "  _tprintf("}, {"page": 180, "x": 144.0, "y": 199.5, "text": "    _T(\"Message sent to server, receiving reply as follows:\\n\"));"}, {"page": 180, "x": 144.0, "y": 224.0, "text": "  while (ReadFile(hPipe, szBuffer, BUFFER_SIZE * sizeof(TCHAR),"}, {"page": 180, "x": 144.0, "y": 234.8, "text": "&dwRead, NULL) && GetLastError() != ERROR_MORE_DATA)"}, {"page": 180, "x": 144.0, "y": 247.0, "text": "  {"}, {"page": 180, "x": 144.0, "y": 259.3, "text": "    _tprintf(_T(\"%s\"), szBuffer);"}, {"page": 180, "x": 144.0, "y": 271.5, "text": "  }"}, {"page": 180, "x": 144.0, "y": 296.0, "text": "  _tprintf(_T(\"\\nSuccess!\\nPress ENTER to exit.\"));"}, {"page": 180, "x": 144.0, "y": 308.2, "text": "  scanf_s(\"%c\", szBuffer);"}, {"page": 180, "x": 144.0, "y": 332.7, "text": "  CloseHandle(hPipe);"}, {"page": 180, "x": 144.0, "y": 357.2, "text": "  return 0;"}, {"page": 180, "x": 144.0, "y": 369.4, "text": "}"}, {"page": 180, "x": 126.0, "y": 465.7, "text": "HANDLE hPipe = CreateNamedPipe( szPipename, PIPE_ACCESS_DUPLEX, PIPE_"}, {"page": 180, "x": 126.0, "y": 476.5, "text": "WAIT | PIPE_READMODE_MESSAGE | PIPE_TYPE_MESSAGE, PIPE_UNLIMITED_"}, {"page": 180, "x": 126.0, "y": 487.3, "text": "INSTANCES, BUFFER_SIZE, BUFFER_SIZE, 0, NULL);"}, {"page": 181, "x": 126.0, "y": 172.1, "text": "WriteFile(hPipe, szReply, dwReplyBytes, &dwBytesWritten, NULL);"}]