page": 164, "x": 144.0, "y": 115.3, "text": "#define DRAWING_TIME    2300"}, {"page": 164, "x": 144.0, "y": 139.8, "text": "#define EVENT_NAME    _T( \"__t_event__\" )"}, {"page": 164, "x": 144.0, "y": 164.3, "text": "typedef struct tagPLOTDATA"}, {"page": 164, "x": 144.0, "y": 176.5, "text": "{"}, {"page": 164, "x": 144.0, "y": 188.7, "text": "  int value;"}, {"page": 164, "x": 144.0, "y": 201.0, "text": "  DWORD dwThreadId;"}, {"page": 164, "x": 144.0, "y": 213.2, "text": "  int iMsgID;"}, {"page": 164, "x": 144.0, "y": 225.5, "text": "} PLOTDATA, *PPLOTDATA;"}, {"page": 164, "x": 144.0, "y": 249.9, "text": "LRESULT CALLBACK WindowProcedure(HWND hWnd, UINT uMsg, WPARAM"}, {"page": 164, "x": 144.0, "y": 260.7, "text": "wParam, LPARAM lParam);"}, {"page": 164, "x": 144.0, "y": 273.0, "text": "DWORD WINAPI StartAddress(LPVOID lpParameter);"}, {"page": 164, "x": 144.0, "y": 285.2, "text": "DWORD WINAPI DrawPlot(LPVOID lpParameter);"}, {"page": 164, "x": 144.0, "y": 309.7, "text": "int iMessageID = 0;"}, {"page": 164, "x": 144.0, "y": 321.9, "text": "HANDLE gEvent = NULL;"}, {"page": 164, "x": 144.0, "y": 334.2, "text": "HANDLE hThreads[THREAD_NUMBER];"}, {"page": 164, "x": 144.0, "y": 346.4, "text": "HANDLE hThread = NULL;"}, {"page": 164, "x": 144.0, "y": 370.9, "text": "CRITICAL_SECTION cs;"}, {"page": 164, "x": 144.0, "y": 383.1, "text": "CQueue<PLOTDATA> queue;"}, {"page": 164, "x": 144.0, "y": 407.6, "text": "int WINAPI _tWinMain(HINSTANCE hThis, HINSTANCE hPrev, LPTSTR"}, {"page": 164, "x": 144.0, "y": 418.4, "text": "szCommandLine, int iWndShow)"}, {"page": 164, "x": 144.0, "y": 430.6, "text": "{"}, {"page": 164, "x": 144.0, "y": 442.9, "text": "  UNREFERENCED_PARAMETER(hPrev);"}, {"page": 164, "x": 144.0, "y": 455.1, "text": "  UNREFERENCED_PARAMETER(szCommandLine);"}, {"page": 164, "x": 144.0, "y": 479.6, "text": "  InitializeCriticalSection(&cs);"}, {"page": 164, "x": 144.0, "y": 504.1, "text": "  TCHAR* szWindowClass = _T(\"__basic_MPI_wnd_class__\");"}, {"